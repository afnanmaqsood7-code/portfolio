---
/** Home: one quiet line about Afnan with a small avatar and a link to About. */
import { Image } from 'astro:assets';
import photo from '../../assets/about/afnan.jpg';
---
<section class="teaser" aria-label="About Afnan">
  <div class="container teaser__inner">
    <Image class="teaser__photo" src={photo} alt="" widths={[96, 160]} sizes="48px" loading="lazy" />
    <p class="teaser__line">Product, brand and web designer in Canada. I also paint.</p>
    <a class="teaser__link" href="/about/">More about me <span aria-hidden="true">→</span></a>
  </div>
</section>
<style>
  .teaser { border-top: 1px solid var(--color-border); }
  .teaser__inner { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 1.25rem; padding-block: var(--space-xl); }
  .teaser__inner :global(.teaser__photo) { flex: none; width: 48px; height: 48px; border-radius: 50%; object-fit: cover; object-position: 50% 25%; }
  .teaser__line { flex: 1 1 18rem; margin: 0; font: 600 clamp(1.2rem, 1rem + 1vw, 1.75rem) / 1.25 var(--font-text); letter-spacing: -0.02em; }
  .teaser__link { min-height: 44px; display: inline-flex; align-items: center; gap: .4rem; font-weight: 500; color: var(--color-text); text-decoration: none; }
  .teaser__link:hover { color: var(--color-accent); }
</style>

---
/**
 * Category chips (with counts) and, for Branding, a second row of sub
 * filters. Only categories that have projects are shown. Rendered hidden;
 * the grid script reveals it (no JS = everything visible, no dead buttons).
 */
import { CATEGORY_OPTIONS, SUB_OPTIONS } from '../../utils/categories';
interface Props { counts: Record<string, number>; subCounts: Record<string, number> }
const { counts, subCounts } = Astro.props;
const cats = CATEGORY_OPTIONS.filter((o) => o.id === 'all' || counts[o.id]);
const subs = SUB_OPTIONS.filter((o) => subCounts[o.id]);
---
<div class="cf" data-cat-filter hidden>
  <div class="cf__row" role="group" aria-label="Filter work by category">
    {cats.map((o) => (
      <button type="button" class="cf__chip" data-cat={o.id} aria-pressed={o.id === 'all' ? 'true' : 'false'}>
        {o.label}<span class="cf__n">{o.id === 'all' ? counts.all : counts[o.id]}</span>
      </button>
    ))}
  </div>
  {subs.length > 1 && (
    <div class="cf__sub" role="group" aria-label="Branding type" data-sub-row hidden>
      <button type="button" class="cf__subchip" data-sub="" aria-pressed="true">All branding</button>
      {subs.map((o) => <button type="button" class="cf__subchip" data-sub={o.id} aria-pressed="false">{o.label}</button>)}
    </div>
  )}
</div>
<style>
  .cf { display: grid; gap: .7rem; }
  .cf[hidden], .cf__sub[hidden] { display: none; }
  .cf__row, .cf__sub { display: flex; flex-wrap: wrap; gap: .5rem; }
  .cf__chip { min-height: 44px; display: inline-flex; align-items: center; gap: .5rem; padding: 0 1.1rem; border: 1px solid var(--color-border); border-radius: 999px; background: var(--color-bg); color: var(--color-text); font: 500 .95rem var(--font-text); cursor: pointer; transition: background .3s, color .3s, border-color .3s, transform .3s; }
  .cf__chip:hover { border-color: var(--color-text); transform: translateY(-2px); }
  .cf__chip[aria-pressed='true'] { background: var(--color-text); border-color: var(--color-text); color: var(--color-bg); }
  .cf__n { min-width: 1.5rem; padding: .05rem .4rem; border-radius: 999px; background: var(--color-surface); color: var(--color-text-muted); font-size: .75rem; text-align: center; }
  .cf__chip[aria-pressed='true'] .cf__n { background: var(--clay-bright); color: #fff; }
  .cf__sub { animation: cf-in .35s ease both; }
  .cf__subchip { min-height: 40px; padding: 0 .9rem; border: 0; border-radius: 999px; background: var(--color-surface); color: var(--color-text-muted); font: 500 .85rem var(--font-text); cursor: pointer; }
  .cf__subchip[aria-pressed='true'] { background: #fde7dc; color: var(--color-accent); }
  @keyframes cf-in { from { opacity: 0; transform: translateY(-6px); } }
  @media (prefers-reduced-motion: reduce) { .cf__chip, .cf__sub { transition: none; animation: none; } }
</style>

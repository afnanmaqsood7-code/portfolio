---
/**
 * "● Numbers & Facts" — black title card + grey stat cards (brandlic-style
 * bento). Numbers count up once on enter; final values are in the HTML.
 */
const facts = [
  { n: 5, suffix: '+', label: 'Years designing' },
  { n: 7, suffix: '', label: 'Featured projects' },
  { n: 3, suffix: '', label: 'Platforms in one product' },
  { n: 4, suffix: '', label: 'Disciplines' },
  { n: 2, suffix: '', label: 'Design degrees · MDM, BFA' },
];
---

<section id="facts" class="facts" aria-labelledby="facts-title">
  <div class="facts__grid">
    <div class="facts__lead"><h2 id="facts-title" class="dot-label facts__title">Numbers &amp; Facts</h2></div>
    {facts.map((f) => (
      <div class="facts__card" data-reveal>
        <p class="facts__num"><span data-count={f.n}>{f.n}</span>{f.suffix}</p>
        <p class="facts__label">{f.label}</p>
      </div>
    ))}
  </div>
</section>

<script>
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const els = document.querySelectorAll<HTMLElement>('[data-count]');
  if (!reduce) {
    const io = new IntersectionObserver((entries) => entries.forEach((e) => {
      if (!e.isIntersecting) return;
      const el = e.target as HTMLElement; const end = Number(el.dataset.count); const t0 = performance.now();
      const tick = (t: number) => { const p = Math.min(1, (t - t0) / 1100); el.textContent = String(Math.round(end * (1 - (1 - p) ** 3))); if (p < 1) requestAnimationFrame(tick); };
      el.textContent = '0'; requestAnimationFrame(tick); io.unobserve(el);
    }), { threshold: 0.6 });
    els.forEach((el) => io.observe(el));
  }
</script>

<style>
  .facts { padding: var(--space-2xl) var(--container-pad) var(--space-xl); }
  .facts__grid { display: grid; gap: 0.75rem; grid-template-columns: repeat(2, minmax(0, 1fr)); }
  @media (min-width: 56rem) { .facts__grid { grid-template-columns: 2fr 1fr 1fr; } }
  .facts__lead { grid-column: 1 / -1; background: #0b0b0b; color: #fff; border-radius: 12px; padding: var(--space-m); min-height: 12rem; }
  @media (min-width: 56rem) { .facts__lead { grid-column: auto; grid-row: span 2; min-height: 0; } }
  .facts__title { font: 600 clamp(1.8rem, 1.2rem + 2vw, 3rem) / 1 var(--font-text); letter-spacing: -0.035em; color: #fff; }
  .facts__card { display: flex; flex-direction: column; justify-content: space-between; gap: 2.5rem; background: var(--color-surface); border-radius: 12px; padding: var(--space-m); min-height: 12rem; }
  .facts__num { font: 500 clamp(2.6rem, 1.6rem + 3vw, 4.5rem) / 1 var(--font-text); letter-spacing: -0.04em; }
  .facts__label { padding-top: 0.8rem; border-top: 1px solid var(--color-border); font-size: 0.9rem; font-weight: 500; }
</style>

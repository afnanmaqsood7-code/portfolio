---
/**
 * Afnan's laptop badge (home).
 * - The clip PLAYS continuously on its own (seamless loop: its tail was
 *   cross-faded into its head) — it is not scrubbed by scroll.
 * - Desktop: large on the right of the black hero; as you scroll out of the
 *   hero it shrinks into a small badge docked bottom-right and ROTATES ONCE
 *   (exactly 360°) during that move. Docked, it just keeps playing.
 *   Phones: docked from the start, no rotation.
 * - Decorative (aria-hidden, pointer-events none). Reduced motion / no JS: a
 *   still badge in the hero.
 */
import { Image } from 'astro:assets';
import still from '../../assets/loop/laptop-still.jpg';
---

<div class="loop" data-loop aria-hidden="true">
  <div class="loop__badge" data-loop-badge>
    <Image class="loop__still" src={still} alt="" width={480} height={480} loading="eager" />
    <video class="loop__video" data-loop-video src="/loop/laptop-loop.mp4" muted playsinline preload="auto"></video>
  </div>
</div>

<script>
  import { getTier } from '../../scripts/motion/capabilities';

  const EASE = 0.1; // lerp per 60fps frame toward the scroll position

  const root = document.querySelector<HTMLElement>('[data-loop]');
  if (root && getTier() !== 'none') init(root);

  function init(el: HTMLElement) {
    const badge = el.querySelector<HTMLElement>('[data-loop-badge]')!;
    const video = el.querySelector<HTMLVideoElement>('[data-loop-video]')!;
    const hero = document.querySelector<HTMLElement>('[data-hero]');
    el.classList.add('loop--live');

    // Plays by itself, looping seamlessly.
    video.loop = true;
    video.addEventListener('loadeddata', () => el.classList.add('loop--ready'), { once: true });
    const play = () => void video.play().catch(() => {});
    play();
    document.addEventListener('visibilitychange', () => (document.hidden ? video.pause() : play()));

    const DOCK = { size: 84, margin: 20 };
    let vw = 0, vh = 0, heroH = 0, desktop = false;
    const measure = () => {
      vw = window.innerWidth;
      vh = window.innerHeight;
      heroH = hero?.offsetHeight ?? vh;
      desktop = vw >= 768;
      DOCK.size = desktop ? 84 : 64; // smaller on phones so it covers less text
      DOCK.margin = desktop ? 20 : 14;
    };
    let dirty = true;
    measure();
    window.addEventListener('resize', () => {
      measure();
      dirty = true;
    });

    let smooth = window.scrollY;
    let last = performance.now();
    const frame = (now: number) => {
      const dt = Math.min((now - last) / 16.67, 4);
      last = now;
      const y = window.scrollY;
      smooth += (y - smooth) * (1 - Math.pow(1 - EASE, dt));
      if (Math.abs(y - smooth) < 0.05) {
        if (smooth === y && !dirty) return void requestAnimationFrame(frame);
        smooth = y;
      }
      dirty = false;

      // Hero → dock (desktop); phones are always docked.
      const p = desktop ? Math.min(1, Math.max(0, smooth / (heroH * 0.7))) : 1;
      const e = p * p * (3 - 2 * p); // smoothstep
      const big = Math.min(vw * 0.36, vh * 0.62, 560);
      const size = big + (DOCK.size - big) * e;
      const x = vw * 0.74 - big / 2 + (vw - DOCK.size - DOCK.margin - (vw * 0.74 - big / 2)) * e;
      const yPos = heroH * 0.5 - big / 2 + (vh - DOCK.size - DOCK.margin - (heroH * 0.5 - big / 2)) * e;
      // One full turn while it travels to the corner, then it stays upright.
      const angle = desktop ? e * 360 : 0;
      badge.style.transform = `translate3d(${x.toFixed(1)}px, ${yPos.toFixed(1)}px, 0) rotate(${angle.toFixed(2)}deg)`;
      badge.style.width = badge.style.height = `${size.toFixed(1)}px`;

      requestAnimationFrame(frame);
    };
    requestAnimationFrame(frame);
  }
</script>

<style>
  /* Static (reduced motion / no JS): a still badge on the right of the hero. */
  .loop {
    position: absolute;
    top: 50vh; /* the hero is the first, full-height section */
    right: 6vw;
    width: min(36vw, 62vh, 560px);
    translate: 0 -50%;
    z-index: 5;
    pointer-events: none;
    display: none;
  }
  @media (min-width: 48rem) {
    .loop { display: block; }
  }
  .loop__badge {
    position: relative;
    width: 100%;
    aspect-ratio: 1;
    border-radius: 50%;
    overflow: hidden; /* clips the clip's black square to the badge circle */
    background: #000;
  }
  .loop__still,
  .loop__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .loop__video { opacity: 0; }

  /* Live: one fixed layer; JS positions, sizes and rotates the badge. */
  .loop:global(.loop--live) {
    display: block;
    position: fixed;
    inset: 0;
    width: auto;
    translate: none;
    z-index: 15; /* above page content, below the header */
  }
  .loop:global(.loop--live) .loop__badge {
    position: absolute;
    top: 0;
    left: 0;
    width: 84px;
    will-change: transform;
    box-shadow: 0 10px 30px rgb(0 0 0 / 0.25);
  }
  .loop:global(.loop--ready) .loop__video { opacity: 1; }
</style>

---
/**
 * Home: the six selected projects as large cards. Everything else lives on
 * /work (WorkGrid.astro) with the category filter.
 */
import ProjectCard from './ProjectCard.astro';
import { getFeaturedProjects } from '../../utils/projects';

const all = await getFeaturedProjects();
// The six strongest projects lead as large cards; the rest sit in "More work".
const SELECTED = ['axivus', 'biaco', 'brand-identity', 'glitchard', 'web-saas-design', 'bridging-divides'];
const selected = SELECTED.map((id) => all.find((p) => p.id === id)!).filter(Boolean);
---

<section id="work" class="section work" aria-labelledby="work-title">
  <div class="container stack">
    <div class="work__head">
      <div class="work__titles">
        <p class="dot-label">Selected work</p>
        <h2 id="work-title" class="work__h">Products and brands that are clear, useful and considered.</h2>
      </div>
      <a class="work__all" href="/work/">All work <span aria-hidden="true">→</span></a>
    </div>
    <ul role="list" class="grid work__grid">
      {selected.map((project, i) => <ProjectCard project={project} size="half" eager={i < 2} />)}
    </ul>
  </div>
</section>

<style>
  /* Amy-style centred heading with the role lens under it. */
  .work__head {
    display: grid;
    grid-template-columns: 1fr;
    align-items: end;
    gap: var(--space-s);
    padding-top: var(--space-s);
    border-top: 1px solid var(--color-border);
    margin-bottom: var(--space-l);
  }
  .work__h { max-width: 22ch; font: 600 clamp(1.6rem, 1.1rem + 1.6vw, 2.4rem) / 1.12 var(--font-text); letter-spacing: -0.03em; }
  @media (min-width: 56rem) { .work__head { grid-template-columns: 1fr auto; } }
  .work__titles { display: grid; gap: var(--space-3xs); }
  .work__grid { row-gap: var(--space-xl); }
  /* Amy-style: two equal columns from tablets up (one on phones). */
  @media (min-width: 48rem) {
    .work__grid > :global(.project-card) { grid-column: span 4; }
  }
  @media (min-width: 64rem) {
    .work__grid > :global(.project-card) { grid-column: span 6; }
  }
  .work__grid > :global([hidden]) { display: none; }
  .work__all { min-height: 44px; display: inline-flex; align-items: center; gap: .4rem; font-weight: 500; color: var(--color-text); text-decoration: none; }
  .work__all:hover { color: var(--color-accent); }
  @media (min-width: 56rem) { .work__head { grid-template-columns: 1fr auto; } }
  .work__head :global(.cf) { justify-self: start; }
</style>

---
/**
 * "Selected work" desk scene (home). See CLAUDE.md → 9. Desk scene.
 *
 * DEFAULT (no JS, reduced motion): a sage panel with the illustration (first
 * project on screen). The project list itself is the grid that follows.
 * LIVE (any device that allows motion; scripts/motion/desk.ts adds
 * .desk--live): sticky full-screen stage + one HTML chapter per featured
 * project; the device morphs and the screen switches as you scroll.
 */
import { getImage } from 'astro:assets';
import { getFeaturedProjects, lensPosition } from '../../utils/projects';
import DeskIllustration from './DeskIllustration.astro';

const projects = await getFeaturedProjects();
const chapters = await Promise.all(
  projects.map(async (p, i) => ({
    p,
    // Same optimised image pipeline as the rest of the site, sized for the screen.
    cover: (await getImage({ src: p.data.cover, width: 1000, format: 'webp' })).src,
    label: p.data.year ?? String(i + 1).padStart(2, '0'),
  })),
);
const first = chapters[0];
---

<section id="work" class="desk" data-desk aria-labelledby="desk-title">
  <div class="desk__pin" data-desk-pin>
    <div class="desk__stage" data-desk-stage>
      <DeskIllustration class="desk__ill" device={first?.p.data.device} cover={first?.cover} />
    </div>

    <div class="desk__ui container">
      <header class="desk__head">
        <p class="eyebrow">Selected work</p>
        <h2 id="desk-title">At the desk</h2>
        <p class="desk__intro">Products, brands and the odd painting. Here&rsquo;s what I&rsquo;ve been building.</p>
      </header>

      <p class="desk__label" data-desk-label aria-hidden="true">01</p>

      <!-- One chapter per featured project. Real HTML: screen readers and
           keyboard users get every project even while only one is shown. -->
      <ol class="desk__chapters" role="list" data-desk-chapters>
        {chapters.map(({ p, cover, label }) => (
          <li
            class="desk__chapter"
            data-chapter
            data-lens={p.data.lens}
            data-order-everything={lensPosition(p, 'everything')}
            data-order-product={lensPosition(p, 'product')}
            data-order-brand={lensPosition(p, 'brand')}
            data-cover={cover}
            data-label={label}
            data-device={p.data.device}
          >
            <p class="desk__meta">{p.data.role}</p>
            <h3 class="desk__title">{p.data.title}</h3>
            <p class="desk__summary">{p.data.summary}</p>
            <a class="brush-link desk__link" href={`/work/${p.id}/`}>
              View case study<span class="visually-hidden">: {p.data.title}</span> <span aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<script>
  import { initDesk } from '../../scripts/motion/desk';
  void initDesk();
</script>

<style>
  /* ---------- Shared: the sage studio panel ---------- */
  .desk {
    color: var(--color-on-scene);
    background: var(--color-scene);
  }
  .desk__pin {
    position: relative;
    background-color: var(--color-scene);
    /* Thin horizontal lines; --line-offset moves them up with scroll. */
    background-image: repeating-linear-gradient(to bottom, var(--color-scene-line) 0 1px, transparent 1px 72px);
    background-position: 0 var(--line-offset, 0px);
  }

  /* ---------- Default / static layout ---------- */
  .desk__pin {
    display: grid;
    padding-block: var(--space-2xl);
  }
  .desk__ui { display: contents; }
  .desk__head {
    grid-row: 1;
    width: 100%;
    max-width: var(--container-max);
    margin-inline: auto;
    padding-inline: var(--container-pad);
    display: grid;
    gap: var(--space-2xs);
  }
  .desk__head h2 { font-size: var(--step-4); }
  .desk__intro { color: var(--color-text-muted); max-width: 38ch; }
  .desk__stage {
    grid-row: 2;
    width: 100%;
    max-width: 46rem;
    margin: var(--space-l) auto 0;
    padding-inline: var(--container-pad);
  }
  .desk__ill { width: 100%; height: auto; display: block; }
  .desk__label,
  .desk__chapters { display: none; }

  /* ---------- Live layout ---------- */
  .desk:global(.desk--live) {
    /* ~1 viewport of scroll per chapter, plus the push into the screen. */
    height: calc(100svh + var(--chapters, 5) * 101svh);
  }
  .desk:global(.desk--live) .desk__pin {
    position: sticky;
    top: 0;
    height: 100svh;
    overflow: hidden;
    padding: 0;
    display: block;
  }
  .desk:global(.desk--live) .desk__stage {
    position: absolute;
    inset: 0;
    max-width: none;
    margin: 0;
    padding: 0;
  }
  .desk:global(.desk--live) .desk__ill { width: 100%; height: 100%; }

  .desk:global(.desk--live) .desk__ui {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-columns: 1fr;
    grid-template-rows: auto 1fr auto;
    padding-block: calc(var(--header-h) + var(--space-s)) var(--space-m);
    pointer-events: none; /* the illustration gets the pointer… */
    opacity: calc(1 - var(--push, 0) * 2.5); /* fade out during the push-in */
  }
  .desk:global(.desk--live) .desk__ui a { pointer-events: auto; } /* …except links */
  .desk:global(.desk--live) .desk__head { padding: 0; margin: 0; }
  .desk:global(.desk--live) .desk__head .desk__intro { display: none; }
  .desk:global(.desk--live) .desk__label {
    display: none; /* phones: no room; shown on desktop below */
    grid-row: 1;
    justify-self: end;
    font-family: var(--font-mono);
    font-size: clamp(2.5rem, 1.5rem + 6vw, 12rem);
    line-height: 0.85;
    letter-spacing: -0.04em;
    color: var(--color-on-scene);
    opacity: 0.85;
  }
  /* Phones: illustration on top, chapter text at the bottom. */
  /* Header wraps to two rows on phones, hence the larger top offset. */
  .desk:global(.desk--live) .desk__stage { bottom: 40%; top: 9rem; }
  .desk:global(.desk--live) .desk__ui { padding-top: 7.5rem; }
  .desk:global(.desk--live) .desk__chapters {
    display: grid;
    grid-row: 3;
    align-self: end;
  }
  .desk:global(.desk--live) .desk__chapter {
    grid-area: 1 / 1;
    display: grid;
    gap: var(--space-2xs);
    align-content: end;
    opacity: 0;
    translate: 0 1rem;
    transition:
      opacity 0.45s var(--ease-out),
      translate 0.6s var(--ease-out);
  }
  .desk:global(.desk--live) .desk__chapter :global(a) { pointer-events: none; }
  .desk:global(.desk--live) .desk__chapter[data-active] {
    opacity: 1;
    translate: 0 0;
    transition-delay: 0.08s;
  }
  .desk:global(.desk--live) .desk__chapter[data-active] :global(a) { pointer-events: auto; }
  .desk__chapter[hidden] { display: none !important; }

  /* Desktop: illustration fills the stage (framed left), text on the right. */
  @media (min-width: 64rem) {
    .desk:global(.desk--live) .desk__stage { top: 0; bottom: 0; }
    .desk:global(.desk--live) .desk__ui {
      grid-template-columns: 1fr minmax(18rem, 26rem);
      padding-block: calc(var(--header-h) + var(--space-l)) var(--space-l);
    }
    .desk:global(.desk--live) .desk__head { grid-column: 1; grid-row: 1; }
    .desk:global(.desk--live) .desk__head .desk__intro { display: block; }
    .desk:global(.desk--live) .desk__label { display: block; grid-column: 1; grid-row: 3; justify-self: start; align-self: end; }
    .desk:global(.desk--live) .desk__chapters { grid-column: 2; grid-row: 1 / -1; align-self: center; }
    .desk:global(.desk--live) .desk__chapter { align-content: center; gap: var(--space-xs); translate: 0 1.5rem; }
  }

  .desk__meta {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }
  .desk__title { font-size: var(--step-3); line-height: var(--leading-tight); }
  .desk__summary { color: var(--color-text-muted); max-width: 46ch; }
  .desk__link { justify-self: start; margin-top: var(--space-3xs); font-weight: 500; }
  @media (min-width: 64rem) {
    .desk__title { font-size: var(--step-4); }
  }
</style>

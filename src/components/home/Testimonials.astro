---
/** Testimonials (Amy-style card). Hidden when the list is empty. */
import { site } from '../../site.config';
const list = site.home.testimonials;
const isPlaceholder = (q: string) => q.startsWith('Placeholder');
---

{list.length > 0 && (
  <section class="quotes" aria-labelledby="quotes-title">
    <div class="quotes__inner">
      <h2 id="quotes-title" class="quotes__title">Kind words</h2>
      {list.map((t) => (
        <figure class="quote" data-reveal>
          {isPlaceholder(t.quote) && <span class="quote__flag mono-label">Placeholder</span>}
          <blockquote><p>{t.quote}</p></blockquote>
          <figcaption><i class="quote__mark" aria-hidden="true"></i><span>{t.name}</span> | {t.role}</figcaption>
        </figure>
      ))}
    </div>
  </section>
)}

<style>
  .quotes__inner {
    max-width: var(--container-max);
    margin-inline: auto;
    padding: var(--space-2xl) var(--container-pad);
    display: grid;
    justify-items: center;
    gap: var(--space-l);
  }
  .quotes__title { font-family: var(--font-display); font-weight: 500; font-size: clamp(1.9rem, 1.5rem + 1.6vw, 2.6rem); letter-spacing: 0.01em; }
  .quote {
    position: relative;
    width: 100%;
    max-width: 44rem;
    padding: clamp(1.5rem, 1rem + 2vw, 2.75rem);
    border: 1px solid color-mix(in srgb, var(--color-text) 25%, transparent);
    border-radius: 14px;
    background: var(--color-card);
  }
  .quote blockquote p { font-size: clamp(1.05rem, 1rem + 0.3vw, 1.2rem); line-height: 1.55; }
  .quote figcaption {
    margin-top: 1.25rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-style: italic;
    color: var(--color-text-muted);
  }
  .quote figcaption span { color: var(--color-text); }
  .quote__mark { width: 1.1rem; height: 0.35rem; background: var(--clay-bright); border-radius: 2px; transform: rotate(-12deg); }
  .quote__flag {
    position: absolute;
    top: -0.65rem;
    left: 1.25rem;
    padding: 0.1rem 0.5rem;
    background: var(--color-bg);
    color: var(--color-accent);
  }
</style>

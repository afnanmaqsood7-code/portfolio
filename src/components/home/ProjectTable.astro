---
/**
 * "All projects" table (dverso's "Latest projects ↙" list).
 * Rows: name · type · year · link. Hovering a row shows that project's
 * cover floating beside the cursor (lerped, with a slight tilt from the
 * cursor's speed). Mouse users with motion only; everyone else gets the
 * plain table. Every row is a real link.
 */
import { getImage } from 'astro:assets';
import { getProjects, lensLabel } from '../../utils/projects';

const projects = await getProjects();
const rows = await Promise.all(
  projects.map(async (p) => ({
    href: `/work/${p.id}/`,
    title: p.data.title,
    type: lensLabel(p.data.lens),
    year: p.data.year ?? '—',
    img: (await getImage({ src: p.data.cover, width: 640, format: 'webp' })).src,
  })),
);
---

<section class="ptable" aria-labelledby="ptable-title" data-ptable>
  <div class="ptable__inner">
    <h2 id="ptable-title" class="ptable__title">All <em class="accent">projects</em> <span aria-hidden="true">↙</span></h2>
    <ul class="ptable__rows" role="list">
      {rows.map((r) => (
        <li>
          <a class="ptable__row" href={r.href} data-img={r.img}>
            <span class="ptable__name">{r.title}</span>
            <span class="ptable__type">{r.type}</span>
            <span class="ptable__year">{r.year}</span>
            <span class="ptable__go" aria-hidden="true">View case →</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
  <div class="ptable__preview" aria-hidden="true" data-preview><img alt="" data-preview-img /></div>
</section>

<script>
  import { getTier, hasFinePointer } from '../../scripts/motion/capabilities';

  const root = document.querySelector<HTMLElement>('[data-ptable]');
  if (root && hasFinePointer() && getTier() !== 'none') init(root);

  function init(el: HTMLElement) {
    const preview = el.querySelector<HTMLElement>('[data-preview]')!;
    const img = el.querySelector<HTMLImageElement>('[data-preview-img]')!;
    let x = 0, y = 0, tx = 0, ty = 0, raf = 0, on = false;
    const loop = () => {
      const vx = tx - x;
      x += vx * 0.15;
      y += (ty - y) * 0.15;
      preview.style.transform = `translate3d(${x}px, ${y}px, 0) rotate(${Math.max(-8, Math.min(8, vx * 0.06))}deg)`;
      if (on || Math.abs(vx) > 0.5) raf = requestAnimationFrame(loop);
      else raf = 0;
    };
    el.addEventListener('pointermove', (e) => {
      tx = e.clientX + 24;
      ty = e.clientY - 90;
      if (!raf) { if (!on) { x = tx; y = ty; } raf = requestAnimationFrame(loop); }
    });
    el.querySelectorAll<HTMLAnchorElement>('.ptable__row').forEach((row) => {
      row.addEventListener('pointerenter', () => {
        if (img.src !== new URL(row.dataset.img!, location.href).href) img.src = row.dataset.img!;
        on = true;
        preview.classList.add('is-on');
      });
      row.addEventListener('pointerleave', () => {
        on = false;
        preview.classList.remove('is-on');
      });
    });
  }
</script>

<style>
  .ptable__inner {
    max-width: var(--container-max);
    margin-inline: auto;
    padding: var(--space-2xl) var(--container-pad);
  }
  .ptable__title {
    font: 400 clamp(1.9rem, 1.4rem + 1.8vw, 2.9rem) / 1.05 var(--font-text);
    letter-spacing: -0.04em;
    margin-bottom: var(--space-m);
  }
  .ptable__rows { border-top: 1px solid var(--color-border); }
  .ptable__row {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.25rem 1rem;
    align-items: baseline;
    padding: 1rem 0;
    border-bottom: 1px solid var(--color-border);
    color: var(--color-text);
    text-decoration: none;
    transition: padding 0.35s var(--ease-out), color 0.2s;
  }
  .ptable__name { font: 300 clamp(1.15rem, 1rem + 0.8vw, 1.7rem) var(--font-mono); letter-spacing: -0.02em; }
  .ptable__type,
  .ptable__year,
  .ptable__go { font: 400 0.78rem var(--font-mono); letter-spacing: 0.04em; color: var(--color-text-muted); text-transform: uppercase; }
  .ptable__type { grid-column: 1; }
  .ptable__year { grid-column: 2; grid-row: 1; }
  .ptable__go { display: none; }
  @media (min-width: 48rem) {
    .ptable__row { grid-template-columns: 2.2fr 1fr 0.6fr auto; }
    .ptable__type,
    .ptable__year { grid-column: auto; grid-row: auto; }
    .ptable__go { display: inline; }
    .ptable__row:hover { padding-left: 0.75rem; }
    .ptable__row:hover .ptable__go { color: var(--color-accent); }
  }
  .ptable__preview {
    position: fixed;
    left: 0;
    top: 0;
    z-index: 20;
    width: 280px;
    aspect-ratio: 4 / 3;
    border-radius: 10px;
    overflow: hidden;
    pointer-events: none;
    opacity: 0;
    scale: 0.85;
    transition: opacity 0.25s, scale 0.35s var(--ease-out);
    box-shadow: 0 20px 50px rgb(0 0 0 / 0.2);
  }
  .ptable__preview img { width: 100%; height: 100%; object-fit: cover; }
  .ptable__preview:global(.is-on) { opacity: 1; scale: 1; }
</style>

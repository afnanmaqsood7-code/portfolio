---
/**
 * Loader (dverso-style): dark blurred screen, name sharpening from a blur,
 * "Loading" + counter, then it fades away. Home only, first visit per
 * session, under ~1.3 s. Never shown without JS or with reduced motion;
 * any click/key skips it. Decorative (aria-hidden) — the page is already
 * rendered underneath.
 */
---

<script is:inline>
  // Runs before the page paints: decide whether to show the loader.
  try {
    if (!sessionStorage.getItem('am-intro') && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
      document.documentElement.classList.add('has-intro');
      sessionStorage.setItem('am-intro', '1');
    }
  } catch (e) {}
</script>

<div class="preloader" aria-hidden="true" data-preloader>
  <div class="preloader__glow"></div>
  <div class="preloader__name">afnan</div>
  <div class="preloader__foot">
    <span>Loading</span><span data-preloader-count>00</span>
  </div>
  <div class="preloader__bar"><i data-preloader-bar></i></div>
</div>

<script>
  const root = document.querySelector<HTMLElement>('[data-preloader]');
  if (root && document.documentElement.classList.contains('has-intro')) {
    const count = root.querySelector<HTMLElement>('[data-preloader-count]')!;
    const bar = root.querySelector<HTMLElement>('[data-preloader-bar]')!;
    const DURATION = 1100;
    const start = performance.now();
    let done = false;
    const finish = () => {
      if (done) return;
      done = true;
      root.classList.add('is-leaving');
      setTimeout(() => document.documentElement.classList.remove('has-intro'), 650);
    };
    const tick = (now: number) => {
      const t = Math.min(1, (now - start) / DURATION);
      const eased = 1 - Math.pow(1 - t, 3);
      count.textContent = String(Math.round(eased * 100)).padStart(2, '0');
      bar.style.transform = `scaleX(${eased})`;
      if (t < 1 && !done) requestAnimationFrame(tick);
      else finish();
    };
    requestAnimationFrame(tick);
    addEventListener('pointerdown', finish, { once: true });
    addEventListener('keydown', finish, { once: true });
  }
</script>

<style>
  .preloader {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: none;
    place-items: center;
    background: #0b0b0b;
    color: #f3ede0;
    pointer-events: none;
  }
  :global(html.has-intro) .preloader { display: grid; }
  .preloader__glow {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 60% 50% at 50% 50%, #3a3a37 0%, #161615 55%, #0b0b0b 100%);
    filter: blur(20px);
  }
  .preloader__name {
    position: relative;
    font: 600 clamp(2.5rem, 1.5rem + 5vw, 5rem) var(--font-text);
    letter-spacing: -0.05em;
    animation: preloader-focus 0.9s var(--ease-out) both;
  }
  @keyframes preloader-focus {
    from { filter: blur(18px); opacity: 0; transform: scale(1.06); }
    to { filter: blur(0); opacity: 1; transform: none; }
  }
  .preloader__foot {
    position: absolute;
    left: var(--container-pad);
    right: var(--container-pad);
    bottom: 2.25rem;
    display: flex;
    justify-content: space-between;
    font: 400 0.75rem var(--font-mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #b3ad9f;
  }
  .preloader__bar {
    position: absolute;
    left: var(--container-pad);
    right: var(--container-pad);
    bottom: 1.5rem;
    height: 1px;
    background: rgb(255 255 255 / 0.12);
  }
  .preloader__bar i {
    position: absolute;
    inset: 0;
    background: #f3ede0;
    transform-origin: left;
    transform: scaleX(0);
  }
  .preloader:global(.is-leaving) {
    opacity: 0;
    filter: blur(12px);
    transition: opacity 0.6s var(--ease-out), filter 0.6s var(--ease-out);
  }
</style>

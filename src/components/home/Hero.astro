---
/**
 * Home hero — liquid-glass style from Afnan's hero prompt, with her intro in
 * the style of her reference ("Hi there, I'm Afnan! 👋" + a one-line mission).
 * Built in Astro + plain CSS/TS (no React/Tailwind/framer-motion: stack rule).
 *
 * - Full-viewport black section (no photo or video — removed at Afnan's
 *   request), intro LEFT-aligned.
 * - Liquid-glass email pill (opens the visitor's mail app, static site),
 *   a glass CTA, and three glass icon buttons.
 */
import { site } from '../../site.config';
---

<section class="hero" aria-labelledby="hero-title" data-hero>

  <div class="hero__content">
    <h1 id="hero-title" class="hero__title">
      {site.heroTitle} <span class="hero__wave" aria-hidden="true">👋</span>
    </h1>
    <p class="hero__subtitle">{site.heroSubtitle}</p>

    <form class="hero__form liquid-glass" data-hello-form action={`mailto:${site.email}`} method="get">
      <label class="visually-hidden" for="hero-email">Your email</label>
      <input id="hero-email" name="email" type="email" required autocomplete="email" placeholder="Enter your email" />
      <button type="submit" class="hero__submit" aria-label="Send">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5 12h14M12 5l7 7-7 7" />
        </svg>
      </button>
    </form>

    <a href="#work" class="hero__cta liquid-glass">{site.heroCta}</a>
  </div>

  <ul class="hero__social" role="list">
    <li>
      <a class="hero__icon liquid-glass" href={site.linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn (opens in a new tab)">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6zM2 9h4v12H2zM4 6a2 2 0 1 0 0-4 2 2 0 0 0 0 4z" />
        </svg>
      </a>
    </li>
    <li>
      <a class="hero__icon liquid-glass" href={`mailto:${site.email}`} aria-label={`Email ${site.email}`}>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="2" y="4" width="20" height="16" rx="2" /><path d="m22 7-10 6L2 7" />
        </svg>
      </a>
    </li>
    <li>
      <a class="hero__icon liquid-glass" href={site.resume} download aria-label="Download resume (PDF)">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><path d="M14 2v6h6M12 18v-6M9 15l3 3 3-3" />
        </svg>
      </a>
    </li>
  </ul>
</section>

<script>
  const root = document.querySelector<HTMLElement>('[data-hero]');
  if (root) {
    initHelloForm(root);
  }

  /** "Enter your email" → opens a pre-filled email to Afnan (no server). */
  function initHelloForm(el: HTMLElement) {
    const form = el.querySelector<HTMLFormElement>('[data-hello-form]');
    if (!form) return;
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const from = (form.elements.namedItem('email') as HTMLInputElement).value.trim();
      const to = form.action.replace(/^mailto:/, '');
      const subject = encodeURIComponent('Hello from your portfolio');
      const body = encodeURIComponent(`Hi Afnan,\n\nI'd like to talk. You can reach me at ${from}.\n`);
      window.location.href = `mailto:${to}?subject=${subject}&body=${body}`;
    });
  }

</script>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    background: #000;
    color: #fff;
  }
  .hero__content {
    position: relative;
    z-index: 10;
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    gap: 1.5rem;
    width: 100%;
    max-width: var(--container-max);
    margin-inline: auto;
    padding: 7rem var(--container-pad) 2rem; /* top room for the floating navbar */
    text-align: left;
  }
  @media (min-width: 48rem) {
    .hero__content > * { max-width: 34rem; }
  }

  /* Bold, wide headline in the style Afnan chose ("Hi there, I'm …! 👋"). */
  .hero__title {
    font-family: var(--font-hero);
    font-weight: 800;
    font-size: clamp(2rem, 1.2rem + 3vw, 3.75rem);
    line-height: 1.08;
    letter-spacing: -0.02em;
    color: #fff;
    text-wrap: balance;
  }
  .hero__wave {
    display: inline-block;
    transform-origin: 70% 75%;
    animation: hero-wave 2.4s ease-in-out 0.6s infinite;
  }
  @keyframes hero-wave {
    0%, 60%, 100% { transform: rotate(0deg); }
    10%, 30% { transform: rotate(14deg); }
    20% { transform: rotate(-8deg); }
    40% { transform: rotate(-4deg); }
    50% { transform: rotate(10deg); }
  }

  .hero__form {
    width: 100%;
    max-width: 36rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.5rem 0.5rem 0.5rem 1.5rem;
    border-radius: 999px;
  }
  .hero__form input {
    flex: 1;
    min-width: 0;
    min-height: 44px;
    border: 0;
    background: transparent;
    color: #fff;
    font-size: 1rem;
    outline: none;
  }
  .hero__form input::placeholder { color: rgb(255 255 255 / 0.55); }
  .hero__form:focus-within { box-shadow: inset 0 1px 1px rgb(255 255 255 / 0.1), 0 0 0 2px rgb(255 255 255 / 0.7); }
  .hero__submit {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: 50%;
    background: #fff;
    color: #000;
    cursor: pointer;
    transition: transform 0.2s;
  }
  .hero__submit:hover { transform: translateX(2px); }

  .hero__subtitle {
    max-width: 36rem;
    font-size: clamp(1rem, 0.95rem + 0.3vw, 1.2rem);
    line-height: 1.55;
    color: #fff;
  }

  .hero__cta {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0.75rem 2rem;
    border-radius: 999px;
    color: #fff;
    font-size: 0.875rem;
    font-weight: 500;
    text-decoration: none;
    transition: background-color 0.2s;
  }
  .hero__cta:hover { color: #fff; background: rgb(255 255 255 / 0.05); }

  .hero__social {
    position: relative;
    z-index: 10;
    display: flex;
    gap: 1rem;
    width: 100%;
    max-width: var(--container-max);
    margin-inline: auto;
    padding: 0 var(--container-pad) 3rem;
  }
  .hero__icon {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    color: rgb(255 255 255 / 0.8);
    transition: color 0.2s, background-color 0.2s;
  }
  .hero__icon:hover { color: #fff; background: rgb(255 255 255 / 0.05); }

  /* White focus rings on the dark hero. */
  .hero :global(:focus-visible) { outline-color: #fff; }
</style>

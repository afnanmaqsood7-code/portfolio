---
/**
 * Home hero — brandlic-style editorial layout (Afnan's reference), original
 * build with her content.
 * - Top left: huge bold name + a typed second line with a blinking caret
 *   ("_Product designer" → Brand / Web / UX…).
 * - Centre: an image card (her Axivus work) that grows to full width as the
 *   page scrolls (GSAP ScrollTrigger scrub; sticky stage). No motion → static.
 * - Bottom: orange name mark left, short intro + "● scroll down" right.
 * Accessibility: H1 is real text; rotating word is aria-hidden with the full
 * role list in visually-hidden text.
 */
import { site } from '../../site.config';

const { roles, intro, status, location } = site.home;
// Reel chapters: start time (s) → project. Matches public/home/reel.mp4.
const chapters = [
  [0.0, 'axivus', 'Axivus'], [2.1, 'biaco', 'Biaaco Med'], [4.2, 'evacovation', 'Evacovation'], [6.3, 'web-saas-design', 'Website Design'], [8.4, 'bridging-divides', 'Bridging Divides'], [10.5, 'brand-identity', 'Build One'], [12.6, 'packaging', 'Packaging Design'], [14.7, 'rabia-welfare', 'Rabia Welfare Hospital'], [16.8, 'ssr', 'School of Social Responsibility'], [18.9, 'amazon', 'Amazon E-commerce'], [21.0, 'social-media', 'Social Media'],
] as const;
const roleList = `${roles.slice(0, -1).join(', ')} and ${roles.at(-1)} designer`;
---

<section class="hero" aria-labelledby="hero-title" data-hero>
  <div class="hero__stage">
    <canvas class="hero__grid" data-hero-grid aria-hidden="true"></canvas>
    <span class="hero__line" aria-hidden="true"></span>
    <div class="hero__top">
      <h1 id="hero-title" class="hero__title">
        <span class="hero__name">{site.name}</span>
        <span class="hero__role" aria-hidden="true">_<span data-typed data-words={JSON.stringify(roles)}>{roles[0]}</span><span class="hero__caret"></span> designer</span>
        <span class="hero__role hero__ghost" aria-hidden="true">_{[...roles].sort((a, b) => b.length - a.length)[0]}<span class="hero__caret"></span> designer</span>
        <span class="visually-hidden">, {roleList.toLowerCase()}</span>
      </h1>
      <div class="hero__aside">
        <p class="hero__intro">{intro}</p>
        <div class="hero__actions">
          <a class="hero__now" href={`/work/${chapters[0][1]}/`} data-reel-now data-chapters={JSON.stringify(chapters)}>
            <span class="hero__now-k">Now playing</span> <span data-reel-title>{chapters[0][2]}</span> <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
    </div>

    <div class="hero__media" data-hero-media>
      <video src="/home/reel.mp4" poster="/home/reel.jpg" muted loop playsinline autoplay preload="metadata" aria-label="Showreel of Afnan's work: apps, websites, brand identities, packaging, print, e-commerce and social media." data-reel></video>
      <button type="button" class="hero__pause" data-reel-toggle hidden aria-pressed="false"><span class="visually-hidden" data-reel-label>Pause showreel</span><span aria-hidden="true" data-reel-icon>❚❚</span></button>
    </div>

  </div>
</section>

<script>
  import { getTier } from '../../scripts/motion/capabilities';
  import { paintGrid } from '../../scripts/paint-grid';

  const hero = document.querySelector<HTMLElement>('[data-hero]');
  if (hero) {
    const tier = getTier();
    if (tier !== 'none') typeRoles(hero);
    initReel(hero, tier === 'none');
    if (tier !== 'none' && matchMedia('(min-width: 48rem)').matches) void grow(hero);
    // Background: the painted grid — cells light orange under the cursor.
    const stage = hero.querySelector<HTMLElement>('.hero__stage')!;
    const css = getComputedStyle(document.documentElement);
    paintGrid(stage, hero.querySelector<HTMLCanvasElement>('[data-hero-grid]')!, {
      band: (w, h, cell) => { const cols = Math.ceil(w / cell), rows = Math.ceil(h / cell); return { cols, rows, x0: Math.round((w - cols * cell) / 2), y0: 0 }; },
      cell: (w) => (w < 700 ? 44 : 72),
      line: css.getPropertyValue('--ink').trim() || '#0b0b0b',
      lineAlpha: 0.07,
      fill: css.getPropertyValue('--clay-bright').trim() || '#ee5a24',
      maxAlpha: 0.5,
      breathe: 1.4,
    });
  }

  /** Showreel: no autoplay with reduced motion; pause button; pauses off screen. */
  function initReel(root: HTMLElement, reduce: boolean) {
    const v = root.querySelector<HTMLVideoElement>('[data-reel]');
    const btn = root.querySelector<HTMLButtonElement>('[data-reel-toggle]');
    if (!v || !btn) return;
    let paused = reduce, onScreen = true;
    const label = btn.querySelector<HTMLElement>('[data-reel-label]')!;
    const icon = btn.querySelector<HTMLElement>('[data-reel-icon]')!;
    const sync = () => {
      if (!paused && onScreen) void v.play().catch(() => {}); else v.pause();
      btn.setAttribute('aria-pressed', String(paused));
      label.textContent = paused ? 'Play showreel' : 'Pause showreel';
      icon.textContent = paused ? '▶' : '❚❚';
    };
    if (reduce) v.removeAttribute('autoplay');
    btn.hidden = false;
    btn.addEventListener('click', () => { paused = !paused; sync(); });
    // "Now playing" link follows the reel.
    const now = root.querySelector<HTMLAnchorElement>('[data-reel-now]');
    const title = now?.querySelector<HTMLElement>('[data-reel-title]');
    if (now && title) {
      const ch: [number, string, string][] = JSON.parse(now.dataset.chapters || '[]');
      let last = -1;
      v.addEventListener('timeupdate', () => {
        let i = 0; while (i + 1 < ch.length && v.currentTime >= ch[i + 1][0]) i++;
        if (i === last) return; last = i;
        now.classList.remove('is-in'); void now.offsetWidth; now.classList.add('is-in');
        title.textContent = ch[i][2]; now.href = `/work/${ch[i][1]}/`;
      });
    }
    new IntersectionObserver((e) => { onScreen = e[0].isIntersecting; sync(); }).observe(root);
    sync();
  }

  /** Type, hold, erase, next word. */
  function typeRoles(root: HTMLElement) {
    const el = root.querySelector<HTMLElement>('[data-typed]');
    if (!el) return;
    const words: string[] = JSON.parse(el.dataset.words || '[]');
    // Swap whole words (never an empty gap): fade out, change, fade in.
    let w = 0;
    setInterval(() => {
      el.style.opacity = '0';
      setTimeout(() => { w = (w + 1) % words.length; el.textContent = words[w]; el.style.opacity = '1'; }, 250);
    }, 2400);
  }

  /** The image card grows from a small centred card to full-bleed. */
  async function grow(root: HTMLElement) {
    const [{ gsap }, { ScrollTrigger }] = await Promise.all([import('gsap'), import('gsap/ScrollTrigger')]);
    gsap.registerPlugin(ScrollTrigger);
    root.classList.add('hero--live');
    const media = root.querySelector<HTMLElement>('[data-hero-media]')!;
    const video = media.querySelector('video')!;
    const stage = root.querySelector<HTMLElement>('.hero__stage')!;
    const top = root.querySelector<HTMLElement>('.hero__top')!;
    // Fit the small card into the real gap between the name and the intro,
    // measured on this screen, so text and video never overlap.
    const box = () => {
      const S = stage.getBoundingClientRect(), T = top.getBoundingClientRect();
      const B = { top: S.bottom - 40 };
      const gap = 24, y0 = T.bottom - S.top + gap, y1 = B.top - S.top - gap;
      // A wide, cinematic card (2 : 1), as wide as half the screen when space allows.
      let w = S.width * 0.5, h = w / 2;
      if (h > y1 - y0) { h = Math.max(0, y1 - y0); w = h * 2; }
      const x = (S.width - w) / 2, y = y0 + (y1 - y0 - h) / 2;
      return { x, y, w, h, W: S.width, H: S.height };
    };
    const clip = () => { const b = box(); return `inset(${b.y}px ${b.W - b.x - b.w}px ${b.H - b.y - b.h}px ${b.x}px round 14px)`; };
    const scale = () => { const b = box(); return Math.max(b.w / b.W, b.h / b.H); };
    const origin = () => { const b = box(); return `${((b.x + b.w / 2) / b.W) * 100}% ${((b.y + b.h / 2) / b.H) * 100}%`; };
    const st = { trigger: root, start: 'top top', end: 'bottom bottom', scrub: 0.5, invalidateOnRefresh: true };
    gsap.fromTo(media, { clipPath: clip }, { clipPath: 'inset(0px 0px 0px 0px round 0px)', ease: 'none', immediateRender: true, scrollTrigger: st });
    gsap.fromTo(video, { scale, transformOrigin: origin }, { scale: 1, ease: 'none', immediateRender: true, scrollTrigger: { ...st } });
    gsap.to(root.querySelectorAll('.hero__top, .hero__bottom'), {
      opacity: 0, ease: 'none',
      scrollTrigger: { trigger: root, start: 'top top', end: '14% top', scrub: true },
    });
  }
</script>

<style>
  .hero { position: relative; }
  .hero__grid { position: absolute; inset: 0; width: 100%; height: 100%; z-index: 0; pointer-events: none; }
  .hero__stage {
    position: relative;
    display: grid;
    grid-template-rows: auto 1fr;
    min-height: calc(100svh - var(--header-h));
    gap: var(--space-l);
    padding: var(--space-m) var(--container-pad) var(--space-m);
  }
  .hero__top { width: 100%; max-width: calc(var(--container-max) - 2 * var(--container-pad)); margin-inline: auto; display: grid; gap: 1.4rem 3rem; align-items: start; position: relative; z-index: 2; }
  @media (min-width: 64rem) { .hero__top { grid-template-columns: auto minmax(0, 1fr); align-items: center; column-gap: clamp(2rem, 4vw, 4rem); }
    /* the role line never widens the column, so nothing shifts */
    .hero__aside { padding: 0; } }
  /* invisible longest role: reserves the column width so nothing moves */
  .hero__ghost { visibility: hidden; height: 0; overflow: hidden; }
  [data-typed] { transition: opacity .25s ease; }
  .hero__aside { display: grid; gap: 1.1rem; justify-items: start; }
  .hero__title { display: grid; font: inherit; }
  .hero__name {
    font: 700 clamp(2.2rem, 0.6rem + 4.4vw, 6rem) / 0.94 var(--font-text);
    letter-spacing: -0.045em;
    color: var(--color-text);
    white-space: nowrap;
  }
  .hero__role {
    font: 700 clamp(2.2rem, 0.6rem + 4.4vw, 6rem) / 0.94 var(--font-text);
    letter-spacing: -0.045em;
    color: #9a9a9a;
    white-space: nowrap;
  }
  .hero__caret {
    display: inline-block; width: 0.06em; height: 0.8em; margin-left: 0.04em;
    vertical-align: -0.05em; background: var(--clay-bright);
    animation: blink 1s step-end infinite;
  }
  @keyframes blink { 50% { opacity: 0; } }
  .hero__status { margin: 0; }

  /* Static layout: image card under the name. */
  /* Reel: full content width, same left edge as the name, 16:9. */
  .hero__media { position: relative; width: 100%; max-width: calc(var(--container-max) - 2 * var(--container-pad)); margin-inline: auto; aspect-ratio: 16 / 9; border-radius: 20px; overflow: hidden; z-index: 1; box-shadow: 0 40px 80px -50px rgb(11 11 11 / .45); }
  .hero__media video { display: block; width: 100%; height: 100%; object-fit: cover; background: #0b0b0b; }
  .hero__pause { position: absolute; right: 0.75rem; bottom: 0.75rem; z-index: 3; width: 44px; height: 44px; display: grid; place-items: center; border: 0; border-radius: 50%; background: rgb(11 11 11 / 0.7); color: #fff; font-size: 0.75rem; cursor: pointer; }
  .hero__pause[hidden] { display: none; }
  /* Thin vertical centre line (desktop). */
  .hero__line { display: none; }
  @media (min-width: 56rem) { .hero__line { display: block; position: absolute; top: 0; bottom: 6%; left: 50%; width: 1px; background: var(--color-border); z-index: 0; } }

  .hero__intro { margin: 0; font-size: 1.02rem; line-height: 1.55; color: var(--color-text-muted); }
  /* One fixed row: long project names are truncated, never wrapped, so the
     right column keeps the same height and the name never moves. */
  .hero__actions { display: flex; flex-wrap: nowrap; align-items: center; gap: 1.2rem; }
  .hero__now [data-reel-title] { display: inline-block; max-width: 11.5rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; vertical-align: bottom; }
  @media (max-width: 63.99rem) { .hero__actions { gap: .8rem; } .hero__now [data-reel-title] { max-width: 11rem; } }
  .hero__now { flex: none; white-space: nowrap; display: inline-flex; align-items: center; gap: .45rem; width: fit-content; min-height: 44px; padding: 0 1rem; border-radius: 999px; background: #0b0b0b; color: #fff; text-decoration: none; font-size: .95rem; font-weight: 500; transition: background .3s; }
  .hero__now:hover { background: var(--clay-bright); }
  .hero__now-k { color: #ff9a6b; font-size: .78rem; }
  .hero__now:global(.is-in) [data-reel-title] { animation: now-in .45s ease both; }
  @keyframes now-in { from { opacity: 0; transform: translateY(6px); } }
  @media (prefers-reduced-motion: reduce) { .hero__now:global(.is-in) [data-reel-title] { animation: none; } }

  /* Live (motion, ≥48rem): sticky stage; the card is clipped and grows. */
  .hero:global(.hero--live) { height: 230vh; }
  .hero:global(.hero--live) .hero__stage { position: sticky; top: 0; height: 100svh; min-height: 0; }
  .hero:global(.hero--live) .hero__media {
    max-width: none; width: auto; margin: 0; box-shadow: none;
    position: absolute; inset: 0; border-radius: 0; z-index: 1; aspect-ratio: auto;
    clip-path: inset(31% 30% 36% 30% round 14px);
    will-change: clip-path;
  }
  .hero:global(.hero--live) .hero__media video { will-change: transform; }

  @media (prefers-reduced-motion: reduce) { .hero__caret { animation: none; } }
</style>

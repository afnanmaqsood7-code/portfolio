---
/**
 * Home hero — brandlic-style editorial layout (Afnan's reference), original
 * build with her content.
 * - Top left: huge bold name + a typed second line with a blinking caret
 *   ("_Product designer" → Brand / Web / UX…).
 * - Centre: an image card (her Axivus work) that grows to full width as the
 *   page scrolls (GSAP ScrollTrigger scrub; sticky stage). No motion → static.
 * - Bottom: orange name mark left, short intro + "● scroll down" right.
 * Accessibility: H1 is real text; rotating word is aria-hidden with the full
 * role list in visually-hidden text.
 */
import { site } from '../../site.config';

const { roles, intro, status, location } = site.home;
const roleList = `${roles.slice(0, -1).join(', ')} and ${roles.at(-1)} designer`;
---

<section class="hero" aria-labelledby="hero-title" data-hero>
  <div class="hero__stage">
    <span class="hero__line" aria-hidden="true"></span>
    <div class="hero__top">
      <h1 id="hero-title" class="hero__title">
        <span class="hero__name">{site.name}</span>
        <span class="hero__role" aria-hidden="true">_<span data-typed data-words={JSON.stringify(roles)}>{roles[0]}</span><span class="hero__caret"></span> designer</span>
        <span class="visually-hidden">, {roleList.toLowerCase()}</span>
      </h1>
      <p class="dot-label hero__status">{status} · {location}</p>
    </div>

    <div class="hero__media" data-hero-media>
      <video src="/home/reel.mp4" poster="/home/reel.jpg" muted loop playsinline autoplay preload="metadata" aria-label="Showreel of Afnan's work: VR game, app design, interactive game, illustration and painting." data-reel></video>
      <button type="button" class="hero__pause" data-reel-toggle hidden aria-pressed="false"><span class="visually-hidden" data-reel-label>Pause showreel</span><span aria-hidden="true" data-reel-icon>❚❚</span></button>
    </div>

    <div class="hero__bottom">
      <a href="/" class="hero__mark" aria-hidden="true" tabindex="-1">Afnan</a>
      <div class="hero__intro">
        <p>{intro}</p>
        <a class="dot-label hero__scroll" href="#facts">scroll down</a>
      </div>
    </div>
  </div>
</section>

<script>
  import { getTier } from '../../scripts/motion/capabilities';

  const hero = document.querySelector<HTMLElement>('[data-hero]');
  if (hero) {
    const tier = getTier();
    if (tier !== 'none') typeRoles(hero);
    initReel(hero, tier === 'none');
    if (tier !== 'none' && matchMedia('(min-width: 48rem)').matches) void grow(hero);
  }

  /** Showreel: no autoplay with reduced motion; pause button; pauses off screen. */
  function initReel(root: HTMLElement, reduce: boolean) {
    const v = root.querySelector<HTMLVideoElement>('[data-reel]');
    const btn = root.querySelector<HTMLButtonElement>('[data-reel-toggle]');
    if (!v || !btn) return;
    let paused = reduce, onScreen = true;
    const label = btn.querySelector<HTMLElement>('[data-reel-label]')!;
    const icon = btn.querySelector<HTMLElement>('[data-reel-icon]')!;
    const sync = () => {
      if (!paused && onScreen) void v.play().catch(() => {}); else v.pause();
      btn.setAttribute('aria-pressed', String(paused));
      label.textContent = paused ? 'Play showreel' : 'Pause showreel';
      icon.textContent = paused ? '▶' : '❚❚';
    };
    if (reduce) v.removeAttribute('autoplay');
    btn.hidden = false;
    btn.addEventListener('click', () => { paused = !paused; sync(); });
    new IntersectionObserver((e) => { onScreen = e[0].isIntersecting; sync(); }).observe(root);
    sync();
  }

  /** Type, hold, erase, next word. */
  function typeRoles(root: HTMLElement) {
    const el = root.querySelector<HTMLElement>('[data-typed]');
    if (!el) return;
    const words: string[] = JSON.parse(el.dataset.words || '[]');
    let w = 0, i = words[0].length, erasing = true;
    const step = () => {
      const word = words[w];
      if (!erasing) {
        el.textContent = word.slice(0, ++i);
        if (i >= word.length) { erasing = true; return void setTimeout(step, 1800); }
        setTimeout(step, 85);
      } else {
        el.textContent = word.slice(0, --i);
        if (i <= 0) { erasing = false; w = (w + 1) % words.length; return void setTimeout(step, 260); }
        setTimeout(step, 45);
      }
    };
    setTimeout(step, 2200);
  }

  /** The image card grows from a small centred card to full-bleed. */
  async function grow(root: HTMLElement) {
    const [{ gsap }, { ScrollTrigger }] = await Promise.all([import('gsap'), import('gsap/ScrollTrigger')]);
    gsap.registerPlugin(ScrollTrigger);
    root.classList.add('hero--live');
    const media = root.querySelector<HTMLElement>('[data-hero-media]')!;
    gsap.fromTo(media,
      { clipPath: 'inset(31% 30% 36% 30% round 14px)' },
      { clipPath: 'inset(0% 0% 0% 0% round 0px)', ease: 'none',
        scrollTrigger: { trigger: root, start: 'top top', end: 'bottom bottom', scrub: 0.5 } });
    gsap.to(root.querySelectorAll('.hero__top, .hero__bottom'), {
      opacity: 0, ease: 'none',
      scrollTrigger: { trigger: root, start: '15% top', end: '45% top', scrub: true },
    });
  }
</script>

<style>
  .hero { position: relative; }
  .hero__stage {
    position: relative;
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: var(--space-l);
    min-height: calc(100svh - var(--header-h));
    padding: var(--space-m) var(--container-pad) var(--space-m);
  }
  .hero__top { display: flex; flex-wrap: wrap; align-items: flex-start; justify-content: space-between; gap: 1rem; position: relative; z-index: 2; }
  .hero__title { display: grid; font: inherit; }
  .hero__name {
    font: 700 clamp(3rem, 1.2rem + 7.4vw, 8.5rem) / 0.92 var(--font-text);
    letter-spacing: -0.045em;
    color: var(--color-text);
  }
  .hero__role {
    font: 700 clamp(3rem, 1.2rem + 7.4vw, 8.5rem) / 0.92 var(--font-text);
    letter-spacing: -0.045em;
    color: #9a9a9a;
  }
  .hero__caret {
    display: inline-block; width: 0.06em; height: 0.8em; margin-left: 0.04em;
    vertical-align: -0.05em; background: var(--clay-bright);
    animation: blink 1s step-end infinite;
  }
  @keyframes blink { 50% { opacity: 0; } }
  .hero__status { margin-top: 0.6rem; }

  /* Static layout: image card under the name. */
  .hero__media { border-radius: 14px; overflow: hidden; }
  .hero__media { position: relative; aspect-ratio: 16 / 9; }
  .hero__media video { display: block; width: 100%; height: 100%; object-fit: cover; background: #0b0b0b; }
  .hero__pause { position: absolute; right: 0.75rem; bottom: 0.75rem; z-index: 3; width: 44px; height: 44px; display: grid; place-items: center; border: 0; border-radius: 50%; background: rgb(11 11 11 / 0.7); color: #fff; font-size: 0.75rem; cursor: pointer; }
  .hero__pause[hidden] { display: none; }
  /* Thin vertical centre line (desktop). */
  .hero__line { display: none; }
  @media (min-width: 56rem) { .hero__line { display: block; position: absolute; top: 0; bottom: 6%; left: 50%; width: 1px; background: var(--color-border); z-index: 0; } }

  .hero__bottom { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 1rem; position: relative; z-index: 2; }
  .hero__mark { font: 700 clamp(1.6rem, 1rem + 2vw, 2.6rem) var(--font-text); letter-spacing: -0.04em; color: var(--clay-bright); text-decoration: none; }
  .hero__intro { display: grid; gap: 0.8rem; max-width: 34rem; }
  @media (min-width: 56rem) { .hero__intro { width: calc(50% - var(--container-pad)); max-width: none; } .hero__intro p { font-size: 1.35rem; line-height: 1.35; letter-spacing: -0.01em; } }
  .hero__intro p { color: var(--color-text); line-height: 1.5; }
  .hero__scroll { font-size: 0.8rem; color: var(--color-text-muted); text-decoration: none; }

  /* Live (motion, ≥48rem): sticky stage; the card is clipped and grows. */
  .hero:global(.hero--live) { height: 230vh; }
  .hero:global(.hero--live) .hero__stage { position: sticky; top: 0; height: 100svh; min-height: 0; }
  .hero:global(.hero--live) .hero__media {
    position: absolute; inset: 0; border-radius: 0; z-index: 1; aspect-ratio: auto;
    clip-path: inset(31% 30% 36% 30% round 14px);
    will-change: clip-path;
  }

  @media (prefers-reduced-motion: reduce) { .hero__caret { animation: none; } }
</style>

---
/**
 * Home hero — from Afnan's hero prompt (liquid-glass style), with her content.
 * Built in Astro + plain CSS/TS (no React/Tailwind/framer-motion: stack rule).
 *
 * - Full-viewport black section; background video autoplays (muted) and
 *   loops with a fade-to-black: fade in 500 ms on canplay, fade out 500 ms
 *   when ≤ 0.55 s remain, on ended → black, 100 ms pause, restart, fade in.
 *   Opacity is animated with requestAnimationFrame (no CSS transition).
 * - Big serif headline with one italic word, a liquid-glass email pill, a
 *   subtitle, a glass CTA, and three glass icon buttons.
 * - The email pill opens the visitor's mail app (static site, no server).
 * - Reduced motion: no autoplay; a still frame is shown instead.
 */
import { site } from '../../site.config';
---

<section class="hero" aria-labelledby="hero-title" data-hero>
  <video
    class="hero__video"
    data-hero-video
    src={site.heroVideo}
    muted
    autoplay
    playsinline
    preload="auto"
    aria-hidden="true"
  ></video>
  <div class="hero__shade" aria-hidden="true"></div>

  <div class="hero__content">
    <h1 id="hero-title" class="hero__title">
      {site.heroTitle} <em>{site.heroTitleItalic}</em>.
    </h1>

    <form class="hero__form liquid-glass" data-hello-form action={`mailto:${site.email}`} method="get">
      <label class="visually-hidden" for="hero-email">Your email</label>
      <input id="hero-email" name="email" type="email" required autocomplete="email" placeholder="Enter your email" />
      <button type="submit" class="hero__submit" aria-label="Send">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5 12h14M12 5l7 7-7 7" />
        </svg>
      </button>
    </form>

    <p class="hero__subtitle">{site.heroSubtitle}</p>

    <a href="#work" class="hero__cta liquid-glass">{site.heroCta}</a>
  </div>

  <ul class="hero__social" role="list">
    <li>
      <a class="hero__icon liquid-glass" href={site.linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn (opens in a new tab)">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6zM2 9h4v12H2zM4 6a2 2 0 1 0 0-4 2 2 0 0 0 0 4z" />
        </svg>
      </a>
    </li>
    <li>
      <a class="hero__icon liquid-glass" href={`mailto:${site.email}`} aria-label={`Email ${site.email}`}>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="2" y="4" width="20" height="16" rx="2" /><path d="m22 7-10 6L2 7" />
        </svg>
      </a>
    </li>
    <li>
      <a class="hero__icon liquid-glass" href={site.resume} download aria-label="Download resume (PDF)">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><path d="M14 2v6h6M12 18v-6M9 15l3 3 3-3" />
        </svg>
      </a>
    </li>
  </ul>
</section>

<script>
  import { getTier } from '../../scripts/motion/capabilities';

  const root = document.querySelector<HTMLElement>('[data-hero]');
  if (root) {
    initHelloForm(root);
    initVideo(root);
  }

  /** "Enter your email" → opens a pre-filled email to Afnan (no server). */
  function initHelloForm(el: HTMLElement) {
    const form = el.querySelector<HTMLFormElement>('[data-hello-form]');
    if (!form) return;
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const from = (form.elements.namedItem('email') as HTMLInputElement).value.trim();
      const to = form.action.replace(/^mailto:/, '');
      const subject = encodeURIComponent('Hello from your portfolio');
      const body = encodeURIComponent(`Hi Afnan,\n\nI'd like to talk. You can reach me at ${from}.\n`);
      window.location.href = `mailto:${to}?subject=${subject}&body=${body}`;
    });
  }

  /** Autoplay loop with a 500 ms fade to/from black (rAF-driven opacity). */
  function initVideo(el: HTMLElement) {
    const video = el.querySelector<HTMLVideoElement>('[data-hero-video]');
    if (!video) return;
    const FADE_MS = 500;
    const FADE_OUT_AT = 0.55; // seconds before the end

    if (getTier() === 'none') {
      // Reduced motion: no playback; show a calm still (late frame).
      video.removeAttribute('autoplay');
      video.pause();
      const still = () => { video.currentTime = Math.max(0, video.duration - 0.6); };
      if (video.readyState >= 1) still();
      else video.addEventListener('loadedmetadata', still, { once: true });
      video.style.opacity = '1';
      return;
    }

    video.style.opacity = '0';
    let raf = 0;
    let fadingOut = false;

    const fadeTo = (target: number, onDone?: () => void) => {
      cancelAnimationFrame(raf);
      const from = parseFloat(video.style.opacity || '0');
      const start = performance.now();
      const step = (now: number) => {
        const t = Math.min(1, (now - start) / FADE_MS);
        video.style.opacity = String(from + (target - from) * t);
        if (t < 1) raf = requestAnimationFrame(step);
        else onDone?.();
      };
      raf = requestAnimationFrame(step);
    };

    const start = () => {
      fadingOut = false;
      void video.play().catch(() => {});
      fadeTo(1);
    };

    video.addEventListener('canplay', start, { once: true });
    video.addEventListener('timeupdate', () => {
      if (!fadingOut && video.duration && video.duration - video.currentTime <= FADE_OUT_AT) {
        fadingOut = true;
        fadeTo(0);
      }
    });
    video.addEventListener('ended', () => {
      cancelAnimationFrame(raf);
      video.style.opacity = '0';
      setTimeout(() => {
        video.currentTime = 0;
        start();
      }, 100);
    });
    video.addEventListener('error', () => console.warn('[hero] video failed to load:', video.currentSrc));
    // If it was already playable before this script ran.
    if (video.readyState >= 3) start();
  }
</script>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    background: #000;
    color: #fff;
  }
  .hero__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center bottom;
  }
  /* Soft shade so white text stays readable over the video. */
  .hero__shade {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at center, rgb(0 0 0 / 0.15) 0%, rgb(0 0 0 / 0.55) 100%);
    pointer-events: none;
  }

  .hero__content {
    position: relative;
    z-index: 10;
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
    padding: 7rem 1.5rem 3rem; /* top room for the floating navbar */
    text-align: center;
  }
  @media (min-width: 48rem) {
    .hero__content { transform: translateY(-12%); }
  }

  .hero__title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(3.5rem, 2rem + 8vw, 8rem); /* ~text-7xl → text-9xl */
    line-height: 1;
    letter-spacing: -0.025em;
    color: #fff;
    text-wrap: balance;
  }
  @media (min-width: 48rem) {
    .hero__title { white-space: nowrap; }
  }
  .hero__title em { font-style: italic; }

  .hero__form {
    width: 100%;
    max-width: 36rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.5rem 0.5rem 0.5rem 1.5rem;
    border-radius: 999px;
  }
  .hero__form input {
    flex: 1;
    min-width: 0;
    min-height: 44px;
    border: 0;
    background: transparent;
    color: #fff;
    font-size: 1rem;
    outline: none;
  }
  .hero__form input::placeholder { color: rgb(255 255 255 / 0.55); }
  .hero__form:focus-within { box-shadow: inset 0 1px 1px rgb(255 255 255 / 0.1), 0 0 0 2px rgb(255 255 255 / 0.7); }
  .hero__submit {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: 50%;
    background: #fff;
    color: #000;
    cursor: pointer;
    transition: transform 0.2s;
  }
  .hero__submit:hover { transform: translateX(2px); }

  .hero__subtitle {
    max-width: 36rem;
    padding-inline: 1rem;
    font-size: 0.875rem;
    line-height: 1.65;
    color: #fff;
  }

  .hero__cta {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0.75rem 2rem;
    border-radius: 999px;
    color: #fff;
    font-size: 0.875rem;
    font-weight: 500;
    text-decoration: none;
    transition: background-color 0.2s;
  }
  .hero__cta:hover { color: #fff; background: rgb(255 255 255 / 0.05); }

  .hero__social {
    position: relative;
    z-index: 10;
    display: flex;
    justify-content: center;
    gap: 1rem;
    padding-bottom: 3rem;
  }
  .hero__icon {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    color: rgb(255 255 255 / 0.8);
    transition: color 0.2s, background-color 0.2s;
  }
  .hero__icon:hover { color: #fff; background: rgb(255 255 255 / 0.05); }

  /* White focus rings on the dark hero. */
  .hero :global(:focus-visible) { outline-color: #fff; }
</style>

---
/**
 * Video ribbon — a scroll-driven 3D "ribbon" of work cards (adapted from the
 * "Vante" recreation prompt Afnan supplied). One number drives everything:
 * scroll progress p (0→1), smoothed `p += (target - p) * .09` each frame.
 *
 * - Two-part headline slides across in opposite directions.
 * - A continuous ribbon of cards runs along a FIXED 3D rail (shallow near arc,
 *   long far runs), then each card flies to its slot in a calm 3×2 grid
 *   (2×3 on narrow screens). Cards are two-sided; the back face flips uv.x so
 *   images are never mirrored.
 * - Cards carry AFNAN'S projects (covers now; a `video` URL can be added per
 *   card later). The prompt's eight third-party videos are NOT used — they
 *   are another studio's portfolio work.
 * - three.js is lazy-loaded when the section approaches; rendering pauses off
 *   screen. Reduced motion / no WebGL / no JS: a short static block (the
 *   projects are listed below in the Selected work grid anyway).
 * - Grid phase (p > .86): hover shows the project name pill; click opens it.
 */
import { getImage } from 'astro:assets';
import { getFeaturedProjects } from '../../utils/projects';
import { site } from '../../site.config';

const projects = await getFeaturedProjects();
const cover = async (src: ImageMetadata) => (await getImage({ src, width: 1200, format: 'webp' })).src;
const cards = [
  ...(await Promise.all(projects.map(async (p) => ({ title: p.data.title, href: `/work/${p.id}/`, image: await cover(p.data.cover) })))),
  // Sixth slot: her paintings & illustration.
  { title: 'Studio — paintings', href: '/studio', image: await cover(projects[0].data.cover) },
].slice(0, 6);
---

<section class="vr" aria-labelledby="vr-title" data-ribbon>
  <div class="vr__track" data-ribbon-track>
    <div class="vr__stage" data-ribbon-stage>
      <h2 id="vr-title" class="vr__h" aria-label={`${site.ribbon.line1} ${site.ribbon.line2}`}>
        <div class="vr__hl vr__l1" data-r="l1" aria-hidden="true"><span>{site.ribbon.line1}</span></div>
        <div class="vr__hl vr__l2" data-r="l2" aria-hidden="true"><span>{site.ribbon.line2}</span></div>
      </h2>
      <div class="vr__cap" data-r="cap">{site.ribbon.caption}</div>
      <div class="vr__glow" data-r="glow" aria-hidden="true"></div>
      <div class="vr__cross" data-r="cross" aria-hidden="true"><i>+</i></div>
      <div class="vr__rule" data-r="rule" aria-hidden="true"></div>
      <canvas class="vr__gl" data-r="gl" aria-hidden="true"></canvas>
      <a class="vr__hint" data-r="hint" href="#contact">START A PROJECT &nbsp;→</a>
      <div class="vr__bot">
        <p>{site.ribbon.note}</p>
        <div class="vr__mid">PRODUCT<s>/</s>BRAND<s>/</s>WEB<s>/</s>PAINTING</div>
        <a class="vr__r" href="#work">VIEW ALL WORK</a>
      </div>
      <div class="vr__name" data-r="name" aria-hidden="true"></div>
      <!-- Data for the script; the same projects are real links in the grid below. -->
      <script type="application/json" data-ribbon-cards set:html={JSON.stringify(cards)} />
    </div>
  </div>
</section>

<script>
  import { getTier } from '../../scripts/motion/capabilities';

  const section = document.querySelector<HTMLElement>('[data-ribbon]');
  if (section && getTier() !== 'none') {
    // Lazy-load three.js ~1 viewport before the section.
    const io = new IntersectionObserver(
      (entries) => {
        if (!entries.some((e) => e.isIntersecting)) return;
        io.disconnect();
        import('../../scripts/motion/video-ribbon').then((m) => m.initRibbon(section)).catch((err) => {
          console.warn('[ribbon] unavailable, static fallback.', err);
        });
      },
      { rootMargin: '100% 0px' },
    );
    io.observe(section);
  }
</script>

<style>
  /* ---- Section palette (from the prompt; near-black like the hero) ---- */
  .vr {
    --vr-bg: #0a0a0b;
    --vr-ink: #f4f1ea;
    --vr-mid: #8d8b86;
    --vr-line: rgba(244, 241, 234, 0.14);
    background: var(--vr-bg);
    color: var(--vr-ink);
    font-family: var(--font-tight);
    -webkit-font-smoothing: antialiased;
    overflow-x: clip;
  }
  /* Static (default): a short block. Live: 900vh track + sticky stage. */
  .vr__track { height: auto; }
  .vr:global(.vr--live) .vr__track { height: 900vh; }
  .vr__stage {
    position: relative;
    height: 70vh;
    height: 70svh;
    overflow: hidden;
    background: var(--vr-bg);
  }
  .vr:global(.vr--live) .vr__stage {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100svh;
  }

  .vr__h { margin: 0; font: inherit; }
  .vr__hl {
    position: absolute;
    left: 0;
    right: 0;
    font-weight: 400;
    font-size: clamp(40px, 6.7vw, 130px);
    line-height: 1;
    letter-spacing: -0.055em;
    white-space: nowrap;
    text-align: center;
    will-change: transform;
    color: var(--vr-ink);
  }
  .vr__l1 { top: calc(50% - 0.98em); }
  .vr__l2 { top: calc(50% + 0.03em); }
  .vr__l1 span,
  .vr__l2 span { display: inline-block; }
  .vr__l1 span { margin-right: 15vw; }
  .vr__l2 span { margin-left: 15vw; }
  .vr__cap {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    width: 15em;
    text-align: center;
    font-size: clamp(9px, 0.74vw, 13px);
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: var(--vr-ink);
  }
  .vr__gl { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  .vr__glow {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 42%;
    background: linear-gradient(rgba(244, 241, 234, 0.1), rgba(244, 241, 234, 0));
  }
  .vr__cross {
    position: absolute;
    left: 32px;
    right: 32px;
    top: 37.5%;
    height: 1px;
    background: var(--vr-line);
  }
  .vr__cross i {
    position: absolute;
    left: 50%;
    top: -0.62em;
    margin-left: -0.3em;
    font: 400 13px var(--font-mono);
    font-style: normal;
    color: var(--vr-mid);
    background: var(--vr-bg);
    padding: 0 0.3em;
    line-height: 1.2;
  }
  .vr__hint {
    position: absolute;
    left: 50%;
    top: 33px;
    transform: translateX(-50%);
    font: 400 11.5px var(--font-mono);
    letter-spacing: 0.06em;
    color: var(--vr-ink);
    padding-bottom: 6px;
    border-bottom: 1px solid var(--vr-line);
    text-decoration: none;
  }
  .vr__bot {
    position: absolute;
    left: 32px;
    right: 32px;
    bottom: 26px;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: end;
    font-size: 12.5px;
    line-height: 1.35;
  }
  .vr__bot p { color: var(--vr-ink); max-width: 21em; }
  .vr__mid { font: 400 11.5px var(--font-mono); letter-spacing: 0.06em; }
  .vr__mid s { text-decoration: none; color: var(--vr-mid); margin: 0 0.9em; }
  .vr__r {
    justify-self: end;
    display: flex;
    gap: 12px;
    align-items: center;
    min-height: 44px;
    font: 400 11.5px var(--font-mono);
    letter-spacing: 0.06em;
    color: var(--vr-ink);
    text-decoration: none;
  }
  .vr__r::after { content: ''; width: 22px; height: 1px; background: var(--vr-ink); }
  .vr__r:hover { color: var(--vr-ink); opacity: 0.7; }
  .vr__rule {
    position: absolute;
    left: 3.5vw;
    right: 3.5vw;
    top: 50%;
    height: 1px;
    background: var(--vr-line);
    transform-origin: left;
    transform: scaleX(0);
  }
  .vr__name {
    position: absolute;
    left: 0;
    top: 0;
    padding: 6px 11px;
    background: var(--vr-ink);
    color: var(--vr-bg);
    border-radius: 99px;
    font-size: 11.5px;
    font-weight: 600;
    letter-spacing: 0.04em;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.16s;
    white-space: nowrap;
  }
  .vr :global(:focus-visible) { outline-color: var(--vr-ink); }

  /* Static fallback: headline sits in place, no 3D-only chrome. */
  .vr:not(:global(.vr--live)) .vr__glow,
  .vr:not(:global(.vr--live)) .vr__cross,
  .vr:not(:global(.vr--live)) .vr__rule,
  .vr:not(:global(.vr--live)) .vr__gl { display: none; }
  .vr:not(:global(.vr--live)) .vr__l1 span,
  .vr:not(:global(.vr--live)) .vr__l2 span { margin: 0; }

  @media (max-width: 760px) {
    .vr__bot { left: 18px; right: 18px; bottom: 18px; grid-template-columns: 1fr auto; }
    .vr__mid { display: none; }
    .vr__hint { display: none; }
    .vr__bot p { max-width: 17em; font-size: 11px; }
  }
</style>

---
/**
 * Desk illustration. Generated once from the source illustration, then
 * maintained here. Source: licensed stock illustration, recoloured to
 * the sage & clay palette; hair replaced by a hijab, long sleeves and
 * trousers. Parts carry data-ill="…" hooks for the desk scene animation; the
 * monitor (bezel, screen, keyboard) is reshaped by src/utils/desk-devices.ts.
 * Credit: see site.config.ts → illustrationCredit.
 */
import { DEVICES, deviceGeometry, type DeviceKind } from '../../utils/desk-devices';

interface Props {
  class?: string;
  /** Device and cover shown before any animation (and without JS). */
  device?: DeviceKind;
  cover?: string;
}
const { class: className, device = 'desktop', cover = '' } = Astro.props;
const shape = DEVICES[device];
const g = deviceGeometry(shape);

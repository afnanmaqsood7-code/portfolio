---
/** Standard page heading block used by inner pages. */
interface Props {
  eyebrow?: string;
  title: string;
  lede?: string;
}
const { eyebrow, title, lede } = Astro.props;
---

<header class="page-intro container">
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <h1>{title}</h1>
  {lede && <p class="lede muted">{lede}</p>}
  <slot />
</header>

<style>
  .page-intro {
    padding-block: var(--space-2xl) var(--space-xl);
    display: grid;
    gap: var(--space-s);
  }
  .lede {
    font-size: var(--step-1);
    max-width: 40ch;
    line-height: var(--leading-snug);
  }
</style>

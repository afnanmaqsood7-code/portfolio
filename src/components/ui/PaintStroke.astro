---
/**
 * Decorative painted stroke from /src/assets/paint.
 * Coloured by the accent token via currentColor. Always aria-hidden.
 * data-cursor="brush" turns the custom cursor into a brush dab over it.
 */
import Stroke from '../../assets/paint/stroke-01.svg';

interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<span class:list={['paint-stroke', className]} aria-hidden="true" data-cursor="brush">
  <Stroke />
</span>

<style>
  .paint-stroke {
    display: block;
    color: var(--color-accent);
    width: min(100%, 22rem);
  }
  .paint-stroke :global(svg) {
    width: 100%;
    height: auto;
  }
</style>

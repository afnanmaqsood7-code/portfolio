---
/**
 * Site header — simple text navigation (Afnan's preference): name on the
 * left, plain text links on the right. Sticky, cream with a soft blur.
 * Phones: a JS-free <details> "Menu" with the same links.
 */
import { nav, site } from '../../site.config';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => {
  if (href === '/') return path === '/';
  if (href.startsWith('/#')) return false;
  return path === href || path.startsWith(`${href}/`);
};
const links = [{ label: 'Home', href: '/' }, ...nav];
---

<header class="site-header">
  <div class="site-header__inner">
    <a href="/" class="brand">{site.name}</a>
    <nav aria-label="Primary" class="nav">
      <ul role="list">
        {links.map((l) => (
          <li><a href={l.href} aria-current={isCurrent(l.href) ? 'page' : undefined}>{l.label}</a></li>
        ))}
        <li><a href={site.resume} download>Resume</a></li>
      </ul>
    </nav>
    <button type="button" class="sound-toggle" data-sound-toggle aria-pressed="false" hidden>
      <span class="sound-toggle__bars" aria-hidden="true"><i></i><i></i><i></i></span>
      Sound<span aria-hidden="true" data-sound-state>off</span>
    </button>
    <details class="menu">
      <summary>Menu</summary>
      <ul role="list" class="menu__panel">
        {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
        <li><a href={site.resume} download>Resume</a></li>
      </ul>
    </details>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 30;
    background: color-mix(in srgb, var(--color-bg) 86%, transparent);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
  }
  .site-header__inner {
    max-width: var(--container-max);
    margin-inline: auto;
    padding: 0.5rem var(--container-pad);
    min-height: var(--header-h);
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }
  .brand {
    margin-right: auto;
    font-family: var(--font-text);
    font-weight: 500;
    font-size: 1rem;
    letter-spacing: -0.01em;
    text-decoration: none;
    color: var(--color-text);
    white-space: nowrap;
  }
  .nav ul { display: flex; gap: clamp(1.25rem, 0.8rem + 1.6vw, 2.75rem); }
  .nav a,
  .menu summary {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 0.95rem;
    color: var(--color-text);
    text-decoration: none;
    transition: opacity 0.2s;
  }
  .nav a:hover { opacity: 0.6; color: var(--color-text); }
  .nav a[aria-current='page'] {
    text-decoration: underline;
    text-underline-offset: 6px;
    text-decoration-thickness: 1px;
  }

  .nav,
  .sound-toggle { display: none; }
  .menu { position: relative; }
  .menu summary { cursor: pointer; list-style: none; }
  .menu summary::-webkit-details-marker { display: none; }
  .menu__panel {
    position: absolute;
    right: 0;
    top: calc(100% + 0.25rem);
    min-width: 11rem;
    padding: 0.5rem 0;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
  }
  .menu__panel a { display: block; padding: 0.7rem 1rem; color: var(--color-text); text-decoration: none; }
  .menu__panel a:hover { background: var(--color-surface); }

  @media (min-width: 56rem) {
    .nav { display: block; }
    .sound-toggle:not([hidden]) { display: inline-flex; }
    .menu { display: none; }
  }

  .sound-toggle {
    align-items: center;
    gap: 0.4rem;
    min-height: 44px;
    padding: 0;
    border: 0;
    background: none;
    font: 400 0.75rem var(--font-mono);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    cursor: pointer;
  }
  .sound-toggle:hover,
  .sound-toggle[aria-pressed='true'] { color: var(--color-text); }
  .sound-toggle__bars { display: inline-flex; align-items: end; gap: 2px; height: 10px; }
  .sound-toggle__bars i { width: 2px; height: 3px; background: currentColor; border-radius: 1px; transition: height var(--dur-base); }
  .sound-toggle[aria-pressed='true'] .sound-toggle__bars i:nth-child(1) { height: 6px; }
  .sound-toggle[aria-pressed='true'] .sound-toggle__bars i:nth-child(2) { height: 10px; }
  .sound-toggle[aria-pressed='true'] .sound-toggle__bars i:nth-child(3) { height: 8px; }
</style>

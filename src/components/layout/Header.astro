---
/**
 * Site header, two variants:
 * - default: sticky bar for inner pages (nav wraps on narrow screens).
 * - glass:   home page only — floats over the hero video as a liquid-glass
 *            pill (from Afnan's hero prompt). Phones get a JS-free <details>
 *            menu inside the pill so every page stays one tap away.
 */
import { nav, site } from '../../site.config';

interface Props {
  variant?: 'default' | 'glass';
}
const { variant = 'default' } = Astro.props;

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
// A nav item is "current" when we're on that page (or a child of it).
const isCurrent = (href: string) => {
  if (href.startsWith('/#')) return path.startsWith('/work');
  return path === href || path.startsWith(`${href}/`);
};
---

{variant === 'glass' ? (
  <header class="glass-header">
    <div class="glass-bar">
      <a href="/" class="glass-brand" aria-label={`${site.name}, home`}>{site.name}</a>
      <nav aria-label="Primary" class="glass-nav">
        <ul role="list">
          <li><a href="/" aria-current={path === '/' ? 'page' : undefined}>Home</a></li>
          {nav.map((item) => (
            <li><a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a></li>
          ))}
          <li><a href={site.resume} download>Resume</a></li>
        </ul>
      </nav>
      <button type="button" class="sound-toggle sound-toggle--glass" data-sound-toggle aria-pressed="false" hidden>
        <span class="sound-toggle__bars" aria-hidden="true"><i></i><i></i><i></i></span>
        Sound<span class="sound-toggle__state" aria-hidden="true" data-sound-state>off</span>
      </button>
      <!-- Phones: the same links in a JS-free disclosure menu (plain text). -->
      <details class="glass-menu">
        <summary>Menu</summary>
        <ul role="list" class="glass-menu__panel">
          <li><a href="/">Home</a></li>
          {nav.map((item) => (
            <li><a href={item.href}>{item.label}</a></li>
          ))}
          <li><a href={site.resume} download>Resume</a></li>
        </ul>
      </details>
    </div>
  </header>
) : (
  <header class="site-header">
    <div class="container site-header__inner">
      <a href="/" class="wordmark" aria-label={`${site.name}, home`}>
        {site.name}
      </a>
      <nav aria-label="Primary">
        <ul role="list" class="nav-list">
          {nav.map((item) => (
            <li>
              <a href={item.href} class="brush-link" aria-current={isCurrent(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))}
          <li>
            <a href="#contact" class="nav-contact brush-link">Contact</a>
          </li>
          <li>
            <!-- Revealed by scripts/motion/sound.ts. Off by default. -->
            <button type="button" class="sound-toggle" data-sound-toggle aria-pressed="false" hidden>
              <span class="sound-toggle__bars" aria-hidden="true"><i></i><i></i><i></i></span>
              Sound<span class="sound-toggle__state" aria-hidden="true" data-sound-state>off</span>
            </button>
          </li>
        </ul>
      </nav>
    </div>
  </header>
)}

<style>
  /* ================= Default (inner pages) ================= */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in srgb, var(--color-bg) 92%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: var(--border-w) solid var(--color-border);
  }
  .site-header__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3xs) var(--space-m);
    min-height: var(--header-h);
    padding-block: var(--space-2xs);
  }
  .wordmark {
    font-family: var(--font-display);
    font-size: var(--step-1);
    letter-spacing: var(--tracking-tight);
    text-decoration: none;
  }
  .nav-list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 var(--space-s);
    font-size: var(--step--1);
  }
  .nav-list a {
    display: inline-block;
    padding-block: var(--space-2xs); /* ≥ 44px tap height with line-height */
    text-decoration: none;
  }
  .nav-contact,
  .nav-contact:hover {
    color: var(--color-accent);
    font-weight: 500;
  }

  /* ================= Home (over the black hero): simple text nav ================= */
  /* Afnan's reference: plain white text links, generously spaced, no pills
     or circles. */
  .glass-header {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    z-index: 20;
    color: #fff;
  }
  .glass-bar {
    max-width: var(--container-max);
    margin-inline: auto;
    padding: 1.25rem var(--container-pad);
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }
  .glass-brand {
    margin-right: auto;
    color: #fff;
    font-size: 1.05rem;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }
  .glass-nav ul {
    display: flex;
    gap: clamp(1.5rem, 1rem + 2vw, 3.5rem);
  }
  .glass-nav a,
  .glass-menu summary {
    display: inline-flex;
    align-items: center;
    min-height: 44px; /* touch target */
    color: #fff;
    font-size: 1.05rem;
    text-decoration: none;
    transition: opacity 0.2s;
  }
  .glass-nav a:hover { opacity: 0.65; color: #fff; }
  .glass-nav a[aria-current='page'] { text-decoration: underline; text-underline-offset: 6px; text-decoration-thickness: 1px; }

  /* Phones: plain-text "Menu" opens the list. */
  .glass-nav,
  .glass-bar .sound-toggle { display: none; }
  .glass-menu { position: relative; }
  .glass-menu summary { cursor: pointer; list-style: none; }
  .glass-menu summary::-webkit-details-marker { display: none; }
  .glass-menu__panel {
    position: absolute;
    right: 0;
    top: calc(100% + 0.5rem);
    min-width: 11rem;
    padding: 0.5rem 0;
    background: #000;
    border-top: 1px solid rgb(255 255 255 / 0.2);
  }
  .glass-menu__panel a {
    display: block;
    padding: 0.7rem 0.25rem;
    color: #fff;
    text-decoration: none;
    text-align: right;
  }
  .glass-menu__panel a:hover { opacity: 0.65; }

  @media (min-width: 56rem) {
    .glass-nav { display: block; }
    .glass-bar .sound-toggle:not([hidden]) { display: inline-flex; }
    .glass-menu { display: none; }
  }

  /* ================= Sound toggle (both variants) ================= */
  .sound-toggle {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3xs);
    min-height: 44px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--color-text-muted);
    font-size: var(--step--1);
    cursor: pointer;
  }
  .sound-toggle--glass { color: rgb(255 255 255 / 0.7); font-size: 0.875rem; }
  .sound-toggle[hidden] { display: none; }
  .sound-toggle:hover { color: var(--color-text); }
  .sound-toggle--glass:hover,
  .sound-toggle--glass[aria-pressed='true'] { color: #fff; }
  .sound-toggle__bars {
    display: inline-flex;
    align-items: end;
    gap: 2px;
    height: 12px;
  }
  .sound-toggle__bars i {
    width: 2px;
    height: 4px;
    background: currentColor;
    border-radius: 1px;
    transition: height var(--dur-base) var(--ease-out);
  }
  /* "On" = bars stand tall at different heights (static, no looping motion). */
  .sound-toggle[aria-pressed='true'] { color: var(--color-text); }
  .sound-toggle[aria-pressed='true'] .sound-toggle__bars i:nth-child(1) { height: 7px; }
  .sound-toggle[aria-pressed='true'] .sound-toggle__bars i:nth-child(2) { height: 12px; }
  .sound-toggle[aria-pressed='true'] .sound-toggle__bars i:nth-child(3) { height: 9px; }
</style>

---
/**
 * Site header, two variants:
 * - default: sticky bar for inner pages (nav wraps on narrow screens).
 * - glass:   home page only — floats over the hero video as a liquid-glass
 *            pill (from Afnan's hero prompt). Phones get a JS-free <details>
 *            menu inside the pill so every page stays one tap away.
 */
import { nav, site } from '../../site.config';

interface Props {
  variant?: 'default' | 'glass';
}
const { variant = 'default' } = Astro.props;

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
// A nav item is "current" when we're on that page (or a child of it).
const isCurrent = (href: string) => {
  if (href.startsWith('/#')) return path.startsWith('/work');
  return path === href || path.startsWith(`${href}/`);
};
---

{variant === 'glass' ? (
  <header class="glass-header">
    <div class="glass-bar liquid-glass">
      <div class="glass-left">
        <a href="/" class="glass-brand" aria-label={`${site.name}, home`}>
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="1.5" />
            <path d="M2 12h20M12 2c2.8 2.7 4.2 6 4.2 10S14.8 19.3 12 22M12 2C9.2 4.7 7.8 8 7.8 12s1.4 7.3 4.2 10" stroke="currentColor" stroke-width="1.5" />
          </svg>
          <span>{site.name}</span>
        </a>
        <nav aria-label="Primary" class="glass-nav">
          <ul role="list">
            {nav.map((item) => (
              <li><a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a></li>
            ))}
          </ul>
        </nav>
      </div>
      <div class="glass-right">
        <button type="button" class="sound-toggle sound-toggle--glass" data-sound-toggle aria-pressed="false" hidden>
          <span class="sound-toggle__bars" aria-hidden="true"><i></i><i></i><i></i></span>
          Sound<span class="sound-toggle__state" aria-hidden="true" data-sound-state>off</span>
        </button>
        <a href={site.resume} class="glass-text-btn" download>Resume</a>
        <a href="#contact" class="glass-btn liquid-glass">Contact</a>
        <!-- Phones: links live in this JS-free disclosure menu. -->
        <details class="glass-menu">
          <summary class="glass-btn liquid-glass">Menu</summary>
          <ul role="list" class="glass-menu__panel">
            {nav.map((item) => (
              <li><a href={item.href}>{item.label}</a></li>
            ))}
            <li><a href={site.resume} download>Resume</a></li>
          </ul>
        </details>
      </div>
    </div>
  </header>
) : (
  <header class="site-header">
    <div class="container site-header__inner">
      <a href="/" class="wordmark" aria-label={`${site.name}, home`}>
        {site.name}
      </a>
      <nav aria-label="Primary">
        <ul role="list" class="nav-list">
          {nav.map((item) => (
            <li>
              <a href={item.href} class="brush-link" aria-current={isCurrent(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))}
          <li>
            <a href="#contact" class="nav-contact brush-link">Contact</a>
          </li>
          <li>
            <!-- Revealed by scripts/motion/sound.ts. Off by default. -->
            <button type="button" class="sound-toggle" data-sound-toggle aria-pressed="false" hidden>
              <span class="sound-toggle__bars" aria-hidden="true"><i></i><i></i><i></i></span>
              Sound<span class="sound-toggle__state" aria-hidden="true" data-sound-state>off</span>
            </button>
          </li>
        </ul>
      </nav>
    </div>
  </header>
)}

<style>
  /* ================= Default (inner pages) ================= */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in srgb, var(--color-bg) 92%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: var(--border-w) solid var(--color-border);
  }
  .site-header__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3xs) var(--space-m);
    min-height: var(--header-h);
    padding-block: var(--space-2xs);
  }
  .wordmark {
    font-family: var(--font-display);
    font-size: var(--step-1);
    letter-spacing: var(--tracking-tight);
    text-decoration: none;
  }
  .nav-list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 var(--space-s);
    font-size: var(--step--1);
  }
  .nav-list a {
    display: inline-block;
    padding-block: var(--space-2xs); /* ≥ 44px tap height with line-height */
    text-decoration: none;
  }
  .nav-contact,
  .nav-contact:hover {
    color: var(--color-accent);
    font-weight: 500;
  }

  /* ================= Glass (home, over the hero video) ================= */
  .glass-header {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    z-index: 20;
    padding: 1.5rem;
    color: #fff;
  }
  .glass-bar {
    /* A touch darker than the base liquid glass so white nav text stays
       readable over bright parts of the hero video (e.g. a white hijab). */
    background: rgb(0 0 0 / 0.32);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    max-width: 64rem;
    margin-inline: auto;
    padding: 0.75rem 1.5rem;
    border-radius: 999px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    overflow: visible; /* let the phone menu panel drop below the pill */
  }
  .glass-left,
  .glass-right {
    display: flex;
    align-items: center;
  }
  .glass-left { gap: 2rem; }
  .glass-right { gap: 1rem; }
  .glass-brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: #fff;
    font-size: 1.125rem;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }
  .glass-nav ul {
    display: flex;
    gap: 2rem;
  }
  .glass-nav a,
  .glass-text-btn {
    color: rgb(255 255 255 / 0.8);
    font-size: 0.875rem;
    font-weight: 500;
    text-decoration: none;
    transition: color 0.2s;
  }
  .glass-text-btn { color: #fff; }
  .glass-nav a:hover,
  .glass-nav a[aria-current='page'],
  .glass-text-btn:hover { color: #fff; }
  .glass-btn {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 0.5rem 1.5rem;
    border-radius: 999px;
    color: #fff;
    font-size: 0.875rem;
    font-weight: 500;
    text-decoration: none;
    cursor: pointer;
    list-style: none;
  }
  .glass-btn:hover { color: #fff; background: rgb(255 255 255 / 0.05); }
  summary.glass-btn::-webkit-details-marker { display: none; }

  /* Phones: hide desktop links/buttons, show the Menu disclosure. */
  .glass-nav,
  .glass-text-btn,
  .glass-right > .glass-btn,
  .glass-right .sound-toggle { display: none; }
  .glass-menu { position: relative; }
  .glass-menu__panel {
    position: absolute;
    right: 0;
    top: calc(100% + 0.75rem);
    min-width: 12rem;
    padding: 0.5rem;
    border-radius: 1.25rem;
    background: rgb(0 0 0 / 0.82);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    box-shadow: inset 0 1px 1px rgb(255 255 255 / 0.12);
  }
  .glass-menu__panel a {
    display: block;
    padding: 0.75rem 1rem;
    color: #fff;
    text-decoration: none;
    border-radius: 0.75rem;
  }
  .glass-menu__panel a:hover { background: rgb(255 255 255 / 0.08); }

  @media (min-width: 48rem) {
    .glass-nav,
    .glass-text-btn { display: block; }
    .glass-right > .glass-btn { display: inline-flex; }
    .glass-right .sound-toggle:not([hidden]) { display: inline-flex; }
    .glass-menu { display: none; }
  }

  /* ================= Sound toggle (both variants) ================= */
  .sound-toggle {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3xs);
    min-height: 44px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--color-text-muted);
    font-size: var(--step--1);
    cursor: pointer;
  }
  .sound-toggle--glass { color: rgb(255 255 255 / 0.7); font-size: 0.875rem; }
  .sound-toggle[hidden] { display: none; }
  .sound-toggle:hover { color: var(--color-text); }
  .sound-toggle--glass:hover,
  .sound-toggle--glass[aria-pressed='true'] { color: #fff; }
  .sound-toggle__bars {
    display: inline-flex;
    align-items: end;
    gap: 2px;
    height: 12px;
  }
  .sound-toggle__bars i {
    width: 2px;
    height: 4px;
    background: currentColor;
    border-radius: 1px;
    transition: height var(--dur-base) var(--ease-out);
  }
  /* "On" = bars stand tall at different heights (static, no looping motion). */
  .sound-toggle[aria-pressed='true'] { color: var(--color-text); }
  .sound-toggle[aria-pressed='true'] .sound-toggle__bars i:nth-child(1) { height: 7px; }
  .sound-toggle[aria-pressed='true'] .sound-toggle__bars i:nth-child(2) { height: 12px; }
  .sound-toggle[aria-pressed='true'] .sound-toggle__bars i:nth-child(3) { height: 9px; }
</style>

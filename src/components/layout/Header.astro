---
/**
 * Site header — clear navigation.
 * - Name (left) = Home. Links in recruiter order: Work · About · Studio ·
 *   Play · Contact. "Resume ↓" set apart on the right (download).
 * - "You are here": the current page's link is underlined (aria-current).
 *   On the home page a small scroll-spy underlines Work while the projects
 *   are on screen and Contact at the footer.
 * - Phones: "Menu" opens a full-screen list of large links (+ resume and
 *   email). Works without JS (<details>); with JS it also closes on Esc and
 *   when a link is chosen, and the page doesn't scroll behind it.
 */
import { nav, site } from '../../site.config';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => !href.includes('#') && (path === href || path.startsWith(`${href}/`));
---

<header class="site-header" data-header>
  <div class="site-header__inner">
    <a href="/" class="brand" aria-label={`${site.name} — home`} aria-current={path === '/' ? 'page' : undefined}>{site.name}</a>

    <nav aria-label="Primary" class="nav">
      <ul role="list">
        {nav.map((l) => (
          <li><a href={l.href} data-spy={l.href.split('#')[1] ?? undefined} aria-current={isCurrent(l.href) ? 'page' : undefined}>{l.label}</a></li>
        ))}
      </ul>
    </nav>
    <a class="resume" href={site.resume} download>Resume <span aria-hidden="true">↓</span></a>

    <details class="menu" data-menu>
      <summary aria-label="Menu"><span class="menu__open">Menu</span><span class="menu__close">Close</span></summary>
      <div class="menu__panel">
        <ul role="list" class="menu__links">
          <li><a href="/">Home</a></li>
          {nav.map((l) => (
            <li><a href={l.href} aria-current={isCurrent(l.href) ? 'page' : undefined}>{l.label}</a></li>
          ))}
        </ul>
        <div class="menu__foot">
          <a href={site.resume} download>Download resume ↓</a>
          <a href={`mailto:${site.email}`}>{site.email}</a>
        </div>
      </div>
    </details>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  if (header) {
    // Phone menu: close on Esc or when a link is chosen.
    const menu = header.querySelector<HTMLDetailsElement>('[data-menu]');
    if (menu) {
      menu.addEventListener('click', (e) => {
        if ((e.target as Element).closest('a')) menu.open = false;
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && menu.open) {
          menu.open = false;
          menu.querySelector('summary')?.focus();
        }
      });
    }

    // Home page scroll-spy: underline the link of the section in view.
    // Home only: inner pages show just their own page as current.
    const spyLinks = location.pathname === '/' ? [...header.querySelectorAll<HTMLAnchorElement>('[data-spy]')] : [];
    const targets = spyLinks
      .map((a) => ({ a, el: document.getElementById(a.dataset.spy!) }))
      .filter((t) => t.el && (t.a.pathname === location.pathname || t.a.getAttribute('href')!.startsWith('#')));
    if (targets.length) {
      const visible = new Set<HTMLElement>();
      const update = () => {
        targets.forEach(({ a, el }) => {
          if (visible.has(el!)) a.setAttribute('aria-current', 'location');
          else a.removeAttribute('aria-current');
        });
      };
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => (e.isIntersecting ? visible.add(e.target as HTMLElement) : visible.delete(e.target as HTMLElement)));
          update();
        },
        { rootMargin: '-45% 0px -45% 0px' }, // "in view" = crossing the middle of the screen
      );
      targets.forEach(({ el }) => io.observe(el!));
    }
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 30;
    background: color-mix(in srgb, var(--color-bg) 88%, transparent);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid color-mix(in srgb, var(--color-border) 70%, transparent);
  }
  .site-header__inner {
    max-width: var(--container-max);
    margin-inline: auto;
    padding: 0.5rem var(--container-pad);
    min-height: var(--header-h);
    display: flex;
    align-items: center;
    gap: clamp(1.25rem, 0.5rem + 2vw, 2.5rem);
  }
  .brand {
    margin-right: auto;
    font: 500 1rem var(--font-text);
    letter-spacing: -0.01em;
    color: var(--color-text);
    text-decoration: none;
    white-space: nowrap;
  }

  /* Desktop links */
  .nav { display: none; }
  .nav ul { display: flex; gap: clamp(1.25rem, 0.6rem + 1.6vw, 2.5rem); }
  .nav a,
  .resume {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 0.95rem;
    color: var(--color-text);
    text-decoration: none;
    text-underline-offset: 7px;
    text-decoration-thickness: 1px;
    transition: opacity 0.2s;
  }
  .nav a:hover,
  .resume:hover { opacity: 0.6; color: var(--color-text); }
  /* "You are here" (page or on-page section). */
  .nav a[aria-current] { text-decoration-line: underline; }
  .resume {
    display: none;
    padding-left: clamp(1.25rem, 0.5rem + 2vw, 2.5rem);
    border-left: 1px solid var(--color-border);
    color: var(--color-accent);
    font-weight: 500;
  }
  .resume:hover { color: var(--color-accent); }

  /* Phone menu (full screen) */
  .menu summary {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 0.95rem;
    color: var(--color-text);
    cursor: pointer;
    list-style: none;
  }
  .menu summary::-webkit-details-marker { display: none; }
  .menu__close,
  .menu[open] .menu__open { display: none; }
  .menu[open] .menu__close { display: inline; }
  .menu__panel {
    position: fixed;
    inset: var(--header-h) 0 0 0;
    z-index: 29;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: var(--space-l) var(--container-pad) var(--space-l);
    background: var(--color-bg);
    overflow-y: auto;
  }
  .menu__links li { border-bottom: 1px solid var(--color-border); }
  .menu__links a {
    display: block;
    padding: 0.85rem 0;
    font: 400 clamp(1.9rem, 1.5rem + 2vw, 2.6rem) / 1.1 var(--font-display);
    color: var(--color-text);
    text-decoration: none;
  }
  .menu__links a[aria-current] { font-style: italic; }
  .menu__foot { display: grid; gap: 0.75rem; margin-top: var(--space-l); }
  .menu__foot a { min-height: 44px; display: inline-flex; align-items: center; font: 400 0.8rem var(--font-mono); letter-spacing: 0.05em; text-transform: uppercase; color: var(--color-text); }
  /* backdrop-filter makes the header the containing block for fixed
     children, which would trap the full-screen panel inside the header —
     drop it while the menu is open. */
  .site-header:has(.menu[open]) {
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
    background: var(--color-bg);
  }
  /* Don't scroll the page behind the open menu. */
  :global(html:has(.menu[open])) { overflow: hidden; }

  @media (min-width: 56rem) {
    .nav { display: block; }
    .resume { display: inline-flex; }
    .menu { display: none; }
  }
</style>

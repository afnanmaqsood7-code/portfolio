---
/**
 * Contact + footer (all pages, #contact). Calm, same theme as the rest of the
 * site: white, black type, one orange accent. Top hairline, "● Contact"
 * label, big headline, email + copy, two buttons, then a quiet nav/meta row.
 */
import { nav, site } from '../../site.config';
import Button from '../ui/Button.astro';

const year = new Date().getFullYear();
---

<footer class="site-footer" id="contact">
  <div class="site-footer__inner">
    <div class="contact">
      <p class="dot-label">Contact</p>
      <h2 class="contact__title">Let&rsquo;s get in <span class="accent">touch</span></h2>
      <p class="contact__sub">Hiring for product, brand, web or marketing design? I&rsquo;d love to hear about it.</p>

      <div class="contact__mail">
        <a class="contact__email" href={`mailto:${site.email}`}>{site.email} <span aria-hidden="true">↗</span></a>
        <button type="button" class="contact__copy" data-copy={site.email} hidden><span data-copy-label>Copy email</span></button>
        <span class="visually-hidden" role="status" data-copy-status></span>
      </div>

      <div class="contact__ctas">
        <Button href={site.linkedin} external>LinkedIn ↗</Button>
        <Button href={site.resume} variant="ghost" download>Resume ↓</Button>
      </div>
    </div>

    <div class="meta">
      <nav class="fnav" aria-label="Footer">
        <ul role="list">
          <li><a href="/">Home</a></li>
          {nav.filter((l) => l.label !== 'Contact').map((l) => <li><a href={l.href}>{l.label}</a></li>)}
        </ul>
      </nav>
      <div class="meta__end">
        <span>&copy; {year} {site.name} · {site.home.location}</span>
        <button type="button" class="sound" data-sound-toggle aria-pressed="false" hidden>
          Sound <span aria-hidden="true" data-sound-state>off</span>
        </button>
        <a href="#main">Back to top ↑</a>
      </div>
    </div>
  </div>
</footer>

<script>
  const copy = document.querySelector<HTMLButtonElement>('[data-copy]');
  const label = document.querySelector<HTMLElement>('[data-copy-label]');
  const status = document.querySelector<HTMLElement>('[data-copy-status]');
  if (copy && label && status && navigator.clipboard) {
    copy.hidden = false;
    let t = 0;
    copy.addEventListener('click', async () => {
      try { await navigator.clipboard.writeText(copy.dataset.copy!); label.textContent = 'Copied ✓'; status.textContent = 'Email address copied'; }
      catch { label.textContent = 'Press Ctrl+C'; }
      clearTimeout(t);
      t = window.setTimeout(() => { label.textContent = 'Copy email'; status.textContent = ''; }, 2000);
    });
  }
</script>

<style>
  .site-footer { border-top: 1px solid var(--color-border); background: var(--color-bg); }
  .site-footer__inner { max-width: var(--container-max); margin-inline: auto; padding: var(--space-2xl) var(--container-pad) var(--space-m); }
  .contact { display: grid; justify-items: start; gap: var(--space-s); }
  .contact__title { font: 700 clamp(2.6rem, 1rem + 6vw, 6.5rem) / 0.95 var(--font-text); letter-spacing: -0.045em; }
  .contact__sub { max-width: 32rem; font-size: var(--step-1); color: var(--color-text-muted); }
  .contact__mail { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 1rem; margin-top: var(--space-xs); }
  .contact__email { min-height: 44px; display: inline-flex; align-items: center; font: 600 clamp(1.2rem, 0.8rem + 1.6vw, 2rem) var(--font-text); letter-spacing: -0.02em; color: var(--color-text); text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 0.2em; overflow-wrap: anywhere; }
  .contact__email:hover { color: var(--color-accent); }
  .contact__copy { min-height: 44px; padding: 0 1rem; border: 1px solid var(--color-border); border-radius: 999px; background: none; font: 500 0.9rem var(--font-text); color: var(--color-text); cursor: pointer; }
  .contact__copy[hidden] { display: none; }
  .contact__copy:hover { border-color: var(--color-text); }
  .contact__ctas { display: flex; flex-wrap: wrap; gap: 0.75rem; }

  .meta { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 1rem 2rem; margin-top: var(--space-2xl); padding-top: var(--space-s); border-top: 1px solid var(--color-border); font-size: 0.9rem; color: var(--color-text-muted); }
  .fnav ul { display: flex; flex-wrap: wrap; gap: 0 1.5rem; }
  .fnav a, .meta a { min-height: 44px; display: inline-flex; align-items: center; color: var(--color-text); text-decoration: none; }
  .fnav a:hover, .meta a:hover { color: var(--color-accent); }
  .meta__end { display: flex; flex-wrap: wrap; align-items: center; gap: 0.25rem 1.5rem; }
  .sound { min-height: 44px; padding: 0; border: 0; background: none; font: inherit; color: inherit; cursor: pointer; }
  .sound[hidden] { display: none; }
  .sound:hover, .sound[aria-pressed='true'] { color: var(--color-text); }
</style>

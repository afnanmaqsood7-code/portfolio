---
/**
 * Contact + footer (all pages, #contact). Amy-style "Let's get in touch!"
 * block with a dverso-style row of small mono labels underneath.
 */
import { nav, site } from '../../site.config';

const year = new Date().getFullYear();
---

<footer class="site-footer" id="contact">
  <div class="site-footer__inner">
    <div class="contact">
      <h2 class="contact__title">Let&rsquo;s get in touch!</h2>
      <p class="contact__sub">Open to new opportunities in product, brand and web design.</p>
      <ul role="list" class="contact__links">
        <li><a class="brush-link" href={`mailto:${site.email}`}>{site.email}</a></li>
        <li><a class="brush-link" href={site.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn<span class="visually-hidden"> (opens in a new tab)</span></a></li>
        <li><a class="brush-link" href={site.resume} download>Resume (PDF)</a></li>
      </ul>
    </div>
    <nav class="fnav" aria-label="Footer">
      <ul role="list">
        <li><a href="/">Home</a></li>
        {nav.filter((l) => l.label !== 'Contact').map((l) => <li><a href={l.href}>{l.label}</a></li>)}
        <li><a href={site.resume} download>Resume ↓</a></li>
      </ul>
    </nav>
    <div class="meta" aria-label="Site details">
      <span>&copy; {year} {site.name}</span>
      <span>Based in Ontario, Canada</span>
      <!-- Revealed by scripts/motion/sound.ts. Off by default. -->
      <button type="button" class="sound" data-sound-toggle aria-pressed="false" hidden>
        Sound <span aria-hidden="true" data-sound-state>off</span>
      </button>
      <a href="#main">Back to top ↑</a>
    </div>
  </div>
</footer>

<style>
  .site-footer { border-top: 1px solid var(--color-border); }
  .site-footer__inner {
    max-width: var(--container-max);
    margin-inline: auto;
    padding: var(--space-2xl) var(--container-pad) var(--space-m);
  }
  .contact { display: grid; gap: 0.5rem; justify-items: start; }
  .contact__title {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(1.75rem, 1.4rem + 1.4vw, 2.6rem);
    letter-spacing: 0;
  }
  .contact__sub { font-style: italic; color: var(--color-text-muted); }
  .contact__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 2rem;
    margin-top: var(--space-s);
  }
  .contact__links a { display: inline-flex; align-items: center; min-height: 44px; }
  .fnav { margin-top: var(--space-xl); }
  .fnav ul { display: flex; flex-wrap: wrap; gap: 0 clamp(1rem, 0.5rem + 2vw, 2.5rem); }
  .fnav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font: 400 clamp(1.15rem, 1rem + 0.6vw, 1.5rem) var(--font-display);
    color: var(--color-text);
    text-decoration: none;
  }
  .fnav a:hover { font-style: italic; color: var(--color-text); }
  .sound {
    min-height: 44px;
    margin-block: -12px;
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    letter-spacing: inherit;
    text-transform: inherit;
    color: inherit;
    cursor: pointer;
  }
  .sound[hidden] { display: none; }
  .sound:hover,
  .sound[aria-pressed='true'] { color: var(--color-text); }
  .meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    margin-top: var(--space-m);
    padding-top: var(--space-s);
    border-top: 1px solid var(--color-border);
    font: 400 0.75rem var(--font-mono);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }
  .meta a { color: inherit; text-decoration: none; min-height: 44px; display: inline-flex; align-items: center; margin-block: -12px; }
  .meta a:hover { color: var(--color-text); }
</style>

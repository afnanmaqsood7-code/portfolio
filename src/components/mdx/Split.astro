---
/** Image beside text (stacks on phones). `reverse` puts the image right. */
import { Image } from 'astro:assets';

interface Props { src: ImageMetadata; alt: string; caption?: string; reverse?: boolean }
const { src, alt, caption, reverse = false } = Astro.props;
---

<div class:list={['split cs-wide', { 'split--rev': reverse }]} data-reveal>
  <figure class="split__media">
    <Image src={src} alt={alt} widths={[480, 720, 960, 1200]} sizes="(min-width: 56rem) 34rem, 100vw" loading="lazy" />
    {caption && <figcaption>{caption}</figcaption>}
  </figure>
  <div class="split__text"><slot /></div>
</div>

<style>
  .split { display: grid; gap: var(--space-m); align-items: center; margin-block: var(--space-l); }
  @media (min-width: 56rem) {
    .split { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: var(--space-xl); }
    .split--rev .split__media { order: 2; }
  }
  .split__media { margin: 0; }
  .split__media :global(img) { display: block; width: 100%; height: auto; border-radius: var(--radius-m); }
  figcaption { margin-top: 0.6rem; font-size: var(--step--1); color: var(--color-text-muted); font-style: italic; }
  .split__text :global(> :first-child) { margin-top: 0; }
</style>

---
/**
 * A phone showing a generic shop product page whose image carousel swipes
 * through a brand's listing images on its own (CSS only), beside text.
 * Not branded as any marketplace. Reduced motion: shows the first image.
 */
import { Image } from 'astro:assets';
interface Props { brand: string; product: string; kicker?: string; title: string; max?: number }
const { brand, product, kicker, title, max = 6 } = Astro.props;
const all = import.meta.glob<{ default: ImageMetadata }>('../../assets/projects/amazon/*.jpg', { eager: true });
const imgs = Object.entries(all)
  .filter(([p]) => p.split('/').pop()!.startsWith(brand + '_'))
  .map(([, m]) => m.default)
  .filter((m) => m.width / m.height <= 1.45)
  .slice(0, max);
const n = imgs.length;
---
<div class="lp cs-wide" data-reveal>
  <div class="lp__stage">
    <div class="lp__phone" style={`--n:${n};--t:${n * 2.6}s`}>
      <div class="lp__notch" aria-hidden="true"></div>
      <div class="lp__screen">
        <div class="lp__bar" aria-hidden="true"><span></span><span class="lp__search">Search</span></div>
        <div class="lp__gallery">
          <ul class="lp__slides" role="list" style={`animation-name:lp-slide-${n}`}>
            {imgs.map((m, i) => <li><Image src={m} alt={`${product} listing image ${i + 1}`} width={600} loading="lazy" /></li>)}
          </ul>
          <div class="lp__dots" aria-hidden="true">{imgs.map((_, i) => <i style={`--i:${i}`}></i>)}</div>
        </div>
        <div class="lp__info" aria-hidden="true">
          <p class="lp__name">{product}</p>
          <span class="lp__line" style="width:46%"></span>
          <span class="lp__line lp__line--big" style="width:30%"></span>
          <span class="lp__cta">Add to cart</span>
          <span class="lp__cta lp__cta--alt">Buy now</span>
          <p class="lp__about">About this item</p>
          <span class="lp__line"></span><span class="lp__line" style="width:82%"></span><span class="lp__line" style="width:64%"></span>
        </div>
      </div>
    </div>
  </div>
  <div class="lp__text">
    {kicker && <p class="dot-label">{kicker}</p>}
    <h3>{title}</h3>
    <slot />
  </div>
</div>
<style>
  .lp { display: grid; gap: var(--space-m); align-items: center; margin-block: var(--space-xl); }
  @media (min-width: 64rem) { .lp { grid-template-columns: minmax(0, calc(100% - 44rem - var(--space-xl))) minmax(0, 44rem); gap: var(--space-xl); } }
  .lp__stage { display: grid; place-items: center; padding: var(--space-l) var(--space-m); background: #f3f2ef; border-radius: var(--radius-m); }
  .lp__phone { position: relative; width: min(19rem, 80%); aspect-ratio: 9 / 17.5; padding: 10px; background: #0b0b0b; border-radius: 2.6rem; box-shadow: 0 40px 70px -35px rgb(11 11 11 / .55); }
  .lp__notch { position: absolute; top: 18px; left: 50%; width: 30%; height: 18px; translate: -50% 0; background: #0b0b0b; border-radius: 99px; z-index: 2; }
  .lp__screen { height: 100%; overflow: hidden; border-radius: 2rem; background: #fff; display: flex; flex-direction: column; }
  .lp__bar { display: flex; align-items: center; gap: .5rem; padding: 2.6rem .8rem .6rem; background: #131921; }
  .lp__bar span:first-child { width: 1.1rem; height: 1.1rem; border-radius: 4px; background: #febd69; }
  .lp__search { flex: 1; padding: .3rem .6rem; border-radius: 6px; background: #fff; color: #8a8a8a; font-size: .7rem; }
  .lp__gallery { position: relative; overflow: hidden; aspect-ratio: 1; background: #fff; }
  .lp__slides { display: flex; height: 100%; margin: 0; padding: 0; list-style: none; width: calc(var(--n) * 100%); animation-duration: var(--t); animation-iteration-count: infinite; animation-timing-function: ease-in-out; }
  .lp__slides li { flex: 1; }
  .lp__slides :global(img) { width: 100%; height: 100%; object-fit: contain; display: block; }
  .lp__dots { position: absolute; bottom: 8px; left: 0; right: 0; display: flex; justify-content: center; gap: 5px; }
  .lp__dots i { width: 6px; height: 6px; border-radius: 50%; background: #cfcfcf; }
  .lp__dots i:first-child { background: #0b0b0b; }
  .lp__info { padding: .8rem .9rem; display: grid; gap: .35rem; }
  .lp__name { margin: 0 !important; font-size: .82rem !important; font-weight: 600; line-height: 1.3 !important; }
  .lp__stars { margin: 0 !important; color: #f59e0b; font-size: .75rem !important; } .lp__stars span { color: #555; }
  .lp__cta { margin-top: .3rem; padding: .5rem; border-radius: 99px; background: #ffd814; text-align: center; font-size: .75rem; font-weight: 600; }
  .lp__price { margin: 0 !important; font-size: 1.3rem !important; font-weight: 600; line-height: 1 !important; } .lp__price sup { font-size: .6em; }
  .lp__cta--alt { margin-top: 0; background: #ffa41c; }
  .lp__line--big { height: 12px; background: #dcdcdc; }
  .lp__about { margin: .3rem 0 0 !important; font-size: .72rem !important; font-weight: 600; }
  .lp__line { display: block; height: 6px; width: 100%; border-radius: 3px; background: #ececec; }
  .lp__text { max-width: 36rem; }
  .lp__text :global(h3) { margin-top: .5rem !important; font: 700 clamp(1.5rem, 1rem + 1.4vw, 2.2rem) / 1.1 var(--font-text) !important; letter-spacing: -0.03em; }
  @media (prefers-reduced-motion: reduce) { .lp__slides { animation: none !important; } }
</style>
<script define:vars={{ n }}>
  // Build the slide keyframes for exactly n images: hold, then glide.
  const id = 'lp-slide-' + n;
  if (!document.getElementById(id)) {
    const steps = [];
    for (let i = 0; i < n; i++) {
      const a = (i / n) * 100, b = ((i + 0.82) / n) * 100;
      steps.push(`${a.toFixed(2)}%,${b.toFixed(2)}%{transform:translateX(-${(i * 100 / n).toFixed(4)}%)}`);
    }
    steps.push(`100%{transform:translateX(0)}`);
    const s = document.createElement('style'); s.id = id; s.textContent = `@keyframes ${id}{${steps.join('')}}`;
    document.head.append(s);
  }
</script>

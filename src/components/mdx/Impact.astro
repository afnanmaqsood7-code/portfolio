---
/**
 * Impact tiles: a number, what it means, and where the number comes from
 * (measured, estimate, by design or scope), so every figure stays honest.
 */
interface Item { value: string; label: string; basis?: 'Measured' | 'Team estimate' | 'By design' | 'Scope' }
interface Props { items: Item[] }
const { items } = Astro.props;
---
<ul class="im cs-wide" role="list" data-reveal>
  {items.map((it) => (
    <li>
      <span class="im__v">{it.value}</span>
      <span class="im__l">{it.label}</span>
      {it.basis && <span class="im__b">{it.basis}</span>}
    </li>
  ))}
</ul>
<style>
  .im { display: grid; gap: 1px; margin: var(--space-l) 0; padding: 0; list-style: none; background: var(--color-border); border: 1px solid var(--color-border); border-radius: var(--radius-m); overflow: hidden; }
  @media (min-width: 40rem) { .im { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 64rem) { .im { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .im li { display: grid; gap: .35rem; align-content: start; padding: 1.4rem 1.3rem; background: var(--color-bg); }
  .im__v { font: 700 clamp(1.9rem, 1.3rem + 1.8vw, 2.8rem) / 1 var(--font-text); letter-spacing: -0.04em; color: var(--color-text); }
  .im__l { font-size: .95rem; line-height: 1.4; color: var(--color-text); }
  .im__b { justify-self: start; margin-top: .3rem; padding: .15rem .55rem; border-radius: 999px; background: var(--color-surface); font-size: .72rem; color: var(--color-text-muted); }
</style>

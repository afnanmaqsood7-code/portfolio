---
/**
 * Two images side by side (stacked on phones), always the same height so
 * there are no ragged gaps. Optional `label` per image (e.g. Before / After).
 */
import { Image } from 'astro:assets';

interface Item { src: ImageMetadata; alt: string; label?: string }
interface Props { items: [Item, Item]; caption?: string }
const { items, caption } = Astro.props;
---

<figure class="pair cs-wide" data-reveal>
  <div class="pair__grid">
    {items.map((it) => (
      <div class="pair__item">
        {it.label && <p class="dot-label">{it.label}</p>}
        <div class="pair__frame"><Image src={it.src} alt={it.alt} widths={[480, 720, 960, 1200]} sizes="(min-width: 48rem) 36rem, 100vw" loading="lazy" /></div>
      </div>
    ))}
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .pair { margin-block: var(--space-l); }
  .pair__grid { display: grid; gap: var(--space-m); }
  @media (min-width: 48rem) { .pair__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .pair__item { display: grid; gap: 0.6rem; }
  .pair__item .dot-label { margin: 0 !important; }
  .pair__frame { aspect-ratio: 16 / 10; overflow: hidden; border: 1px solid var(--color-border); border-radius: var(--radius-m); background: #fff; }
  .pair__frame :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; object-position: top left; }
  figcaption { margin-top: 0.8rem; font-size: var(--step--1); color: var(--color-text-muted); }
</style>

---
/**
 * One website: a large browser window with the homepage, then a row of its
 * other pages. Hover (or focus) a frame and it scrolls slowly through the
 * full page, by animating object-position. Reduced motion: no scrolling.
 */
import { Image } from 'astro:assets';
interface Page { src: ImageMetadata; label: string }
interface Props { home: ImageMetadata; homeAlt: string; url?: string; pages?: Page[]; mobile?: Page[]; site: string }
const { home, homeAlt, url = '', pages = [], mobile = [], site } = Astro.props;
---
<div class="site cs-wide" data-reveal>
  <figure class="site__browser">
    <div class="site__bar" aria-hidden="true"><i></i><i></i><i></i><span>{url}</span></div>
    <div class="site__view scroll" tabindex="0" aria-label={`${site} homepage, hover or focus to scroll`}>
      <Image src={home} alt={homeAlt} widths={[800, 1200, 1400]} sizes="(min-width: 90rem) 84rem, 100vw" loading="lazy" />
    </div>
  </figure>
  {pages.length > 0 && (
    <ul class="site__pages" role="list" style={`--n:${pages.length}`}>
      {pages.map((p) => (
        <li>
          <div class="site__page scroll" tabindex="0"><Image src={p.src} alt={`${site} ${p.label} page`} widths={[400, 700]} sizes="(min-width: 64rem) 16rem, 45vw" loading="lazy" /></div>
          <span>{p.label}</span>
        </li>
      ))}
    </ul>
  )}
  {mobile.length > 0 && (
    <ul class="site__mobile" role="list">
      {mobile.map((p) => (
        <li>
          <div class="site__phone scroll" tabindex="0"><Image src={p.src} alt={`${site} ${p.label} on mobile`} widths={[300, 500]} sizes="12rem" loading="lazy" /></div>
          <span>{p.label}</span>
        </li>
      ))}
    </ul>
  )}
</div>
<style>
  .site { display: grid; gap: var(--space-m); margin-block: var(--space-l) var(--space-xl); }
  .site__browser { margin: 0; overflow: hidden; border-radius: var(--radius-m); background: #0b0b0b; box-shadow: 0 30px 60px -35px rgb(11 11 11 / 0.45); }
  .site__bar { display: flex; align-items: center; gap: 0.4rem; padding: 0.7rem 0.9rem; }
  .site__bar i { width: 0.6rem; height: 0.6rem; border-radius: 50%; background: #3a3a3a; }
  .site__bar span { margin-left: 0.8rem; padding: 0.2rem 0.8rem; border-radius: 999px; background: #1f1f1f; color: #9a9a9a; font-size: 0.75rem; }
  .site__view { aspect-ratio: 16 / 9; }
  .scroll { overflow: hidden; background: #fff; outline-offset: 3px; }
  .scroll :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; object-position: 50% 0%; transition: object-position 1.2s ease-out; }
  .scroll:hover :global(img), .scroll:focus-visible :global(img) { object-position: 50% 100%; transition: object-position 22s linear; }
  .site__pages, .site__mobile { display: grid; gap: var(--space-s); margin: 0; padding: 0; list-style: none; }
  .site__pages { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  @media (min-width: 64rem) { .site__pages { grid-template-columns: repeat(var(--n), minmax(0, 1fr)); } }
  .site__mobile { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  @media (min-width: 48rem) { .site__mobile { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .site li { display: grid; gap: 0.5rem; }
  .site li span { font-size: 0.85rem; color: var(--color-text-muted); }
  .site__page { aspect-ratio: 3 / 4; border: 1px solid var(--color-border); border-radius: var(--radius-s, 8px); }
  .site__phone { aspect-ratio: 9 / 19; border: 6px solid #0b0b0b; border-radius: 1.4rem; }
  @media (prefers-reduced-motion: reduce) { .scroll :global(img) { transition: none; } .scroll:hover :global(img), .scroll:focus-visible :global(img) { object-position: 50% 0%; } }
</style>

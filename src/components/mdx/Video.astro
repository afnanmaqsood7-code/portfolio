---
/**
 * Self-hosted video (e.g. a trailer) with native controls. Never autoplays
 * with sound; `preload="none"` + poster so it costs nothing until played.
 */
interface Props {
  src: string;          // path under /public, e.g. /work/into-the-heart-of-mine/trailer.mp4
  poster?: string;      // URL of a still
  title: string;        // accessible name
  caption?: string;
  size?: 'text' | 'wide' | 'full';
}
const { src, poster, title, caption, size = 'wide' } = Astro.props;
---

<figure class:list={['vid', `cs-${size}`]} data-reveal>
  <video src={src} poster={poster} controls playsinline preload="none" aria-label={title}></video>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .vid { margin-block: var(--space-l); }
  video { display: block; width: 100%; height: auto; aspect-ratio: 16 / 9; background: #000; border-radius: var(--radius-m); }
  figcaption { margin-top: 0.6rem; font-size: var(--step--1); color: var(--color-text-muted); font-style: italic; }
</style>

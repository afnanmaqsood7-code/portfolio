---
/**
 * One "lane" of images at the SAME height, widths following each image's
 * aspect ratio (justified row) — mixes portrait and landscape cleanly.
 * Stays one lane on every screen size (Afnan's request). Alt text required.
 */
import { Image } from 'astro:assets';

interface Item { src: ImageMetadata; alt: string }
interface Props { items: Item[]; caption?: string }
const { items, caption } = Astro.props;
---

<figure class="row cs-wide" data-reveal>
  <div class="row__lane">
    {items.map((it) => (
      <div class="row__cell" style={`--ar:${(it.src.width / it.src.height).toFixed(4)}`}>
        <Image src={it.src} alt={it.alt} widths={[480, 720, 960, 1280]} sizes="(min-width: 48rem) 40vw, 50vw" loading="lazy" />
      </div>
    ))}
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .row { margin-block: var(--space-l); }
  .row__lane { display: flex; align-items: flex-start; gap: clamp(0.4rem, 0.2rem + 1vw, var(--space-s)); }
  /* Grow in proportion to aspect ratio => every image ends up the same height. */
  .row__cell { flex: var(--ar) 1 0; min-width: 0; }
  .row__cell :global(img) { display: block; width: 100%; height: auto; border-radius: var(--radius-m); }
  figcaption { margin-top: 0.6rem; font-size: var(--step--1); color: var(--color-text-muted); font-style: italic; }
</style>

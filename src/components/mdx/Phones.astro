---
/**
 * A lane of phone screens (mobile UI) at the same size, each with a small
 * mono label. Scrolls sideways on phones instead of shrinking to nothing.
 */
import { Image } from 'astro:assets';

interface Screen { src: ImageMetadata; alt: string; label?: string }
interface Props { screens: Screen[]; caption?: string; dark?: boolean }
const { screens, caption, dark = false } = Astro.props;
---

<figure class:list={['phones cs-wide', { 'phones--dark': dark }]} data-reveal>
  <ul class="phones__lane" role="list" style={`--n:${screens.length}`}>
    {screens.map((s) => (
      <li class="phones__item">
        <Image class="phones__img" src={s.src} alt={s.alt} widths={[390]} sizes="(min-width: 64rem) 15rem, 60vw" loading="lazy" />
        {s.label && <span class="mono-label phones__label">{s.label}</span>}
      </li>
    ))}
  </ul>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .phones { margin-block: var(--space-l); }
  .phones__lane {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(11rem, 1fr);
    gap: var(--space-s);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding: 0.5rem 0.25rem 1rem;
  }
  @media (min-width: 64rem) { .phones__lane { grid-auto-columns: minmax(0, 1fr); overflow: visible; } }
  .phones__item { display: grid; gap: 0.6rem; justify-items: center; scroll-snap-align: start; }
  .phones__img {
    display: block;
    width: 100%;
    max-width: 15rem;
    height: auto;
    border-radius: 22px;
    border: 1px solid var(--color-border);
    box-shadow: 0 18px 40px rgb(17 17 17 / 0.12);
  }
  .phones__label { color: var(--color-text-muted); text-align: center; }
  figcaption { margin-top: 0.6rem; font-size: var(--step--1); color: var(--color-text-muted); font-style: italic; }
</style>

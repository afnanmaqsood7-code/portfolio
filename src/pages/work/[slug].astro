---
/**
 * Case study page (calm, editorial).
 * Hero: back link → mono eyebrow → big title → summary → wide image →
 * 30-second summary card (role, timeline, team, tools + outcomes).
 * Body: MDX in a breakout grid — text sits in a ~42rem reading column;
 * figures with .cs-wide / .cs-full break out wider (see components/mdx).
 * End: next project.
 */
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getProjects, lensLabel } from '../../utils/projects';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: { project, next: projects[(i + 1) % projects.length] },
  }));
}

const { project, next } = Astro.props;
const { Content } = await render(project);
const d = project.data;
const heroSrc = d.banner ?? d.cover;
const heroAlt = d.banner ? (d.bannerAlt ?? d.coverAlt) : d.coverAlt;
const eyebrow = [d.tags?.join(' · ') ?? lensLabel(d.lens), d.year].filter(Boolean).join(' · ');
const facts = [
  ['Role', d.role],
  ['Timeline', d.timeline],
  ['Team', d.team],
  ['Tools', d.tools.join(', ')],
];
---

<BaseLayout title={d.title} description={d.summary}>
  <article class="cs">
    <header class="cs-hero">
      <div class="cs-hero__text">
        <a class="cs-back mono-label" href="/#work"><span aria-hidden="true">←</span> All work</a>
        <p class="dot-label cs-eyebrow">{eyebrow}</p>
        <h1 class="cs-title">{d.title}</h1>
        <p class="cs-lede">{d.summary}</p>
      </div>

      <Image class="cs-hero__img" src={heroSrc} alt={heroAlt} widths={[800, 1200, 1600, 2000]} sizes="(min-width: 90rem) 84rem, 100vw" loading="eager" fetchpriority="high" />

      <section class="cs-card" aria-label="Project summary">
        <dl class="cs-facts">
          {facts.map(([k, v]) => (
            <div><dt class="mono-label">{k}</dt><dd>{v}</dd></div>
          ))}
        </dl>
        <div class="cs-outcomes">
          <h2 class="mono-label">Outcomes</h2>
          <ul role="list">
            {d.outcomes.slice(0, 3).map((o, i) => <li><span class="cs-outcomes__n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>{o}</li>)}
          </ul>
        </div>
      </section>
    </header>

    <div class="cs-body">
      <Content />
    </div>

    <nav class="cs-next" aria-label="Next project">
      <a href={`/work/${next.id}/`}>
        <span class="mono-label">Next project</span>
        <span class="cs-next__title">{next.data.title} <span aria-hidden="true">→</span></span>
      </a>
    </nav>
  </article>
</BaseLayout>

<style>
  .cs { --text: min(42rem, calc(100% - 2 * var(--container-pad))); }

  /* ---- Hero ---- */
  .cs-hero {
    max-width: var(--container-max);
    margin-inline: auto;
    padding: var(--space-xl) var(--container-pad) 0;
  }
  .cs-hero__text { display: grid; gap: var(--space-xs); }
  .cs-back { display: inline-flex; align-items: center; gap: 0.4rem; min-height: 44px; width: fit-content; text-decoration: none; color: var(--color-text-muted); }
  .cs-back:hover { color: var(--color-text); }
  .cs-eyebrow { color: var(--color-text); }
  .cs-title {
    font: 600 clamp(2.6rem, 1.2rem + 6vw, 6.5rem) / 0.95 var(--font-text);
    letter-spacing: -0.05em;
    text-wrap: balance;
  }
  .cs-lede { font-size: var(--step-1); line-height: 1.45; color: var(--color-text-muted); max-width: 40rem; text-wrap: pretty; }
  /* Desktop: the summary runs the full width under the title,
     from the left edge to the right edge. */
  @media (min-width: 64rem) {
    .cs-lede { max-width: none; justify-self: stretch; width: 100%; margin-top: var(--space-xs); font-size: var(--step-2); line-height: 1.3; color: var(--color-text); letter-spacing: -0.015em; }
  }
  .cs-hero__img { display: block; width: 100%; height: auto; margin-top: var(--space-l); border-radius: var(--radius-m); }

  /* 30-second summary card: facts in one even row, outcomes in another. */
  .cs-card {
    margin-top: var(--space-m);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-m);
    background: var(--color-card);
  }
  .cs-facts { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); }
  @media (min-width: 56rem) { .cs-facts { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .cs-facts > div { padding: var(--space-s) var(--space-m); border-bottom: 1px solid var(--color-border); }
  .cs-facts > div:nth-child(2n) { border-left: 1px solid var(--color-border); }
  @media (min-width: 56rem) { .cs-facts > div + div { border-left: 1px solid var(--color-border); } }
  .cs-facts dt, .cs-outcomes h2 { color: var(--color-text-muted); margin-bottom: 0.35rem; }
  .cs-facts dd { margin: 0; line-height: 1.45; }
  .cs-outcomes { padding: var(--space-s) var(--space-m) var(--space-m); }
  .cs-outcomes ul { display: grid; gap: var(--space-s); }
  @media (min-width: 56rem) { .cs-outcomes ul { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-m); } }
  .cs-outcomes li { display: grid; gap: 0.35rem; line-height: 1.45; }
  .cs-outcomes__n { font: 400 0.75rem var(--font-mono); color: var(--color-accent); }

  /* ---- Body: breakout grid ---- */
  .cs-body {
    display: grid;
    /* ONE left edge for everything: text and wide content both start where
       the page title starts. Text stops at ~46rem; wide runs to the
       container's right edge. */
    --content: min(calc(100% - 2 * var(--container-pad)), calc(var(--container-max) - 2 * var(--container-pad)));
    grid-template-columns:
      [full-start] minmax(var(--container-pad), 1fr)
      [wide-start text-start] minmax(0, min(46rem, var(--content))) [text-end]
      minmax(0, calc(var(--content) - 46rem)) [wide-end]
      minmax(var(--container-pad), 1fr) [full-end];
    padding-block: var(--space-2xl);
    counter-reset: cs-section;
  }
  .cs-body > :global(*) { grid-column: text; }
  .cs-body > :global(.cs-wide) { grid-column: wide; }
  .cs-body > :global(.cs-full) { grid-column: full; }
  .cs-body :global(h2) {
    margin-top: var(--space-2xl);
    padding-top: var(--space-s);
    border-top: 1px solid var(--color-border);
    font: 600 clamp(1.7rem, 1.3rem + 1.4vw, 2.4rem) / 1.1 var(--font-text); letter-spacing: -0.03em;
  }
  /* "01", "02"… above each section heading. */
  .cs-body :global(h2)::before {
    counter-increment: cs-section;
    content: counter(cs-section, decimal-leading-zero);
    display: block;
    margin-bottom: 0.6rem;
    font: 500 0.85rem var(--font-text);
    color: var(--color-accent);
  }
  .cs-body :global(h2:first-child) { margin-top: 0; }
  .cs-body > :global(h2) { grid-column: wide; }
  /* Desktop: editorial two columns. Section heading on the left, text on
     the right edge, so text never leaves an empty band on the right.
     Wide figures still span both columns. */
  @media (min-width: 64rem) {
    .cs-body {
      grid-template-columns:
        [full-start] minmax(var(--container-pad), 1fr)
        [wide-start] minmax(0, calc(var(--content) - 44rem))
        [text-start] minmax(0, 44rem) [text-end wide-end]
        minmax(var(--container-pad), 1fr) [full-end];
    }
    .cs-body > :global(h2) {
      grid-column: wide-start / text-start;
      position: relative;
      padding-right: var(--space-l);
      border-top: 0;
    }
    .cs-body > :global(h2)::after {
      content: ''; position: absolute; top: 0; left: 0;
      width: calc(100% + 44rem); border-top: 1px solid var(--color-border);
    }
    /* First block after a heading sits level with the heading text. */
    .cs-body > :global(h2 + :not(.cs-wide):not(.cs-full)) {
      margin-top: calc(var(--space-2xl) + var(--space-s) + 1.95rem);
    }
    .cs-body > :global(h2:first-child + :not(.cs-wide)) { margin-top: calc(var(--space-s) + 1.95rem); }
    .cs-body > :global(h2 + p) { font-size: var(--step-1); line-height: 1.55; }
  }
  /* Headings inside wide components (Split text) keep the reading rhythm. */
  .cs-body :global(.split h2) { margin-top: 0; }
  .cs-body :global(.cs-actions) { display: flex; flex-wrap: wrap; gap: 0.75rem; justify-content: center; margin-bottom: var(--space-m); }
  .cs-body :global(h3) { margin-top: var(--space-m); font: 600 var(--step-1) / 1.25 var(--font-text); letter-spacing: -0.02em; }
  .cs-body :global(p),
  .cs-body :global(li) { font-size: var(--step-0); line-height: 1.7; }
  .cs-body :global(p) { margin-top: 1em; }
  .cs-body :global(ul:not([role])) { margin-top: 1em; padding-left: 1.2rem; list-style: disc; }
  .cs-body :global(ul:not([role]) li + li) { margin-top: 0.4em; }
  .cs-body :global(strong) { font-weight: 600; }
  .cs-body :global(blockquote) {
    margin-block: var(--space-l);
    padding-left: var(--space-s);
    border-left: 3px solid var(--clay-bright);
    font: 600 var(--step-2) / 1.3 var(--font-text);
  }

  .cs-body :global(table) { width: 100%; margin-top: var(--space-m); border-collapse: collapse; font-size: var(--step--1); }
  .cs-body :global(th) { text-align: left; font-weight: 600; padding: 0 1rem 0.7rem 0; border-bottom: 1px solid var(--color-text); }
  .cs-body :global(td) { padding: 0.8rem 1rem 0.8rem 0; border-bottom: 1px solid var(--color-border); vertical-align: top; line-height: 1.5; color: var(--color-text-muted); }
  .cs-body :global(td:first-child) { color: var(--color-text); font-weight: 500; white-space: nowrap; }

  /* ---- Next project ---- */
  .cs-next { border-top: 1px solid var(--color-border); }
  .cs-next a {
    display: grid;
    gap: 0.4rem;
    max-width: var(--container-max);
    margin-inline: auto;
    padding: var(--space-xl) var(--container-pad);
    text-decoration: none;
    color: var(--color-text);
  }
  .cs-next__title { font: 600 clamp(2rem, 1rem + 4vw, 4.5rem) / 1 var(--font-text); letter-spacing: -0.045em; }
  .cs-next a:hover .cs-next__title { color: var(--color-accent); }
</style>

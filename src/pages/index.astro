---
/**
 * Home — merged direction (dversostudio.io × itsamy.ca), see CLAUDE.md.
 * Loader → hero (outlined name over the painted grid, "I am ___", accent
 * headline) → sage disciplines (sketchbook opens, cards fly out) → featured
 * projects (Amy cards + role lens) → all-projects table (hover previews) →
 * testimonials → from the studio → marquee → contact (footer).
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Preloader from '../components/home/Preloader.astro';
import Hero from '../components/home/Hero.astro';
import Disciplines from '../components/home/Disciplines.astro';
import ProjectGrid from '../components/home/ProjectGrid.astro';
import ProjectTable from '../components/home/ProjectTable.astro';
import Testimonials from '../components/home/Testimonials.astro';
import StudioStrip from '../components/home/StudioStrip.astro';
import Marquee from '../components/home/Marquee.astro';
---

<BaseLayout>
  <Preloader />
  <Hero />
  <Disciplines />
  <ProjectGrid />
  <ProjectTable />
  <Testimonials />
  <StudioStrip />
  <Marquee />
</BaseLayout>

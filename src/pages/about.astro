---
import BaseLayout from '../layouts/BaseLayout.astro';
import StudioStrip from '../components/home/StudioStrip.astro';
import { Image } from 'astro:assets';
import { site } from '../site.config';
import axivus from '../assets/projects/axivus/cover.jpg';
import buildone from '../assets/projects/brand-identity/cover.jpg';
import web from '../assets/projects/web-saas-design/cover.jpg';
import amazon from '../assets/projects/amazon/cover.jpg';

const stats = [
  { n: 5, suffix: '+', label: 'years designing' },
  { n: 13, suffix: '', label: 'projects on this site' },
  { n: 4, suffix: '', label: 'disciplines' },
  { n: 2, suffix: '', label: 'degrees' },
];
const does = [
  { title: 'Product & UX', body: 'Apps and platforms, from flows to final screens.', img: axivus, href: '/work/?cat=product' },
  { title: 'Brand', body: 'Identities, brand books, packaging and print.', img: buildone, href: '/work/?cat=branding' },
  { title: 'Web', body: 'Websites and landing pages built to convert.', img: web, href: '/work/?cat=web' },
  { title: 'Marketing', body: 'E-commerce listings, campaigns and social.', img: amazon, href: '/work/?cat=marketing' },
];
const ring = [
  { k: '01', t: 'Product & UX', href: '/work/?cat=product' },
  { k: '02', t: 'Brand', href: '/work/?cat=branding' },
  { k: '03', t: 'Web', href: '/work/?cat=web' },
  { k: '04', t: 'Marketing', href: '/work/?cat=marketing' },
  { k: '05', t: 'Motion', href: '/work/?cat=motion' },
  { k: '06', t: 'Games & XR', href: '/work/?cat=games' },
  { k: '07', t: 'Painting', href: '#studio' },
  { k: '08', t: 'Contact me', href: '#contact' },
];
const tools = ['Figma', 'Adobe XD', 'Illustrator', 'Photoshop', 'After Effects', 'Premiere Pro', 'Unreal Engine', 'Convai', 'Canva', 'Astro'];
---

<BaseLayout title="About" description="About Afnan Maqsood: product, brand and web designer in Canada, painter and illustrator.">
  <section class="ah" data-about-hero>
    <div class="ah__sky" aria-hidden="true"><span class="ah__moon"></span></div>
    <div class="container ah__inner">
      <div class="ah__text">
        <p class="dot-label ah__eyebrow">About me</p>
        <h1 class="ah__title">Designer with a <span class="accent">painter’s</span> hand</h1>
        <p class="ah__lede">Product, brand and web designer. 5+ years of client work, MDM from Toronto Metropolitan University, BFA in Graphic Design. Based in Canada, open to work.</p>
        <div class="ah__ctas">
          <a class="ah__btn ah__btn--solid" href={site.resume} download>Resume ↓</a>
          <a class="ah__btn" href={site.linkedin} target="_blank" rel="noopener">LinkedIn ↗</a>
        </div>
      </div>

      <div class="cn" data-cn>
        <canvas class="cn__canvas" data-cn-canvas aria-label="3D CN Tower with a ring of cards: Product and UX, Brand, Web, Marketing, Motion, Games and XR, Painting, Contact. Drag or scroll to spin, click a card to explore." role="img"></canvas>
        <svg class="cn__tower" viewBox="0 0 240 640" aria-hidden="true">
          <defs>
            <linearGradient id="cnS" x1="0" x2="1"><stop offset="0" stop-color="#2a2145"/><stop offset=".5" stop-color="#6b5a92"/><stop offset="1" stop-color="#2a2145"/></linearGradient>
          </defs>
          <line x1="120" y1="0" x2="120" y2="120" stroke="#b9acd9" stroke-width="4"/>
          <circle cx="120" cy="4" r="5" fill="#ff6a3d"/>
          <path d="M108 118 h24 l8 72 h-40 z" fill="url(#cnS)"/>
          <ellipse cx="120" cy="198" rx="30" ry="10" fill="#8f7fbf"/>
          <path d="M100 206 L72 640 H168 L140 206 Z" fill="url(#cnS)"/>
          <path d="M112 206 L94 640 M128 206 L146 640" stroke="#3a2f5c" stroke-width="2.5"/>
        </svg>
        <div class="cn__stage" aria-label="What I do, drag or scroll to spin">
          <ul class="cn__ring" role="list" data-ring>
            {ring.map((c, i) => (
              <li class="cn__card" style={`--i:${i};--n:${ring.length}`}>
                <a href={c.href}><span class="cn__k">{c.k}</span><strong>{c.t}</strong></a>
              </li>
            ))}
          </ul>
          <span class="cn__pod" aria-hidden="true"></span>
        </div>
        <div class="cn__seq" data-cn-seq hidden aria-hidden="true"><img src="/about/tower/00.webp" alt="" /><img src="/about/tower/01.webp" alt="" /></div>
        <div class="cn__hints" aria-hidden="true"><span>Scroll to spin</span><span>Click to explore</span></div>
      </div>
    </div>
    <div class="container ah__meta" aria-hidden="true">
      <span>TORONTO, CANADA<br />43.65°N · 79.38°W</span>
      <span class="ah__clock"><span data-clock>--:--</span><br />LOCAL TIME</span>
    </div>
  </section>

  <section class="stats container" aria-label="In numbers">
    <ul role="list" class="stats__row">
      {stats.map((s) => (
        <li><span class="stats__n"><span data-count={s.n}>{s.n}</span>{s.suffix}</span><span class="stats__l">{s.label}</span></li>
      ))}
    </ul>
  </section>

  <section class="does container" aria-labelledby="does-title">
    <p class="dot-label">What I do</p>
    <h2 id="does-title" class="does__h">Four kinds of work, one way of thinking.</h2>
    <ul role="list" class="does__grid">
      {does.map((d) => (
        <li class="does__card">
          <a href={d.href}>
            <div class="does__media"><Image src={d.img} alt="" widths={[600, 900]} sizes="(min-width: 64rem) 22rem, 90vw" loading="lazy" /></div>
            <h3>{d.title} <span aria-hidden="true">→</span></h3>
            <p>{d.body}</p>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <div class="tools" aria-label="Tools I use">
    <div class="tools__track">
      {[0, 1].map((dup) => (
        <ul role="list" aria-hidden={dup ? 'true' : undefined}>{tools.map((t) => <li>{t}</li>)}</ul>
      ))}
    </div>
  </div>

  <StudioStrip />
</BaseLayout>

<script>
  import { getTier } from '../scripts/motion/capabilities';
  const reduce = getTier() === 'none';
  // 3D tower (three.js, loaded lazily). The 2D tower and HTML ring stay as
  // the fallback when WebGL is unavailable.
  const cnBox = document.querySelector<HTMLElement>('[data-cn]');
  const cnCanvas = document.querySelector<HTMLCanvasElement>('[data-cn-canvas]');
  if (new URLSearchParams(location.search).has('capture')) cnCanvas?.setAttribute('data-capture', '1');
  const gl = document.createElement('canvas').getContext('webgl2');
  if (!gl && cnBox) {
    // No WebGL: play a pre-rendered 36-frame turn of the same 3D tower,
    // scrubbed by scroll and drag, so the scene still looks and moves in 3D.
    // Two stacked frames cross-fade by the fractional position, so the turn
    // is continuous rather than stepped.
    const box = cnBox.querySelector<HTMLElement>('[data-cn-seq]')!;
    const [A, B] = Array.from(box.querySelectorAll('img'));
    const N = 60, frames = Array.from({ length: N }, (_, i) => `/about/tower/${String(i).padStart(2, '0')}.webp`);
    const cache = frames.map((f) => { const im = new Image(); im.decoding = 'async'; im.src = f; return im; });
    box.hidden = false; cnBox.classList.add('is-seq');
    let pos = 0, vel = 0, lastY = scrollY, drag: number | null = null, moved = 0, a = -1, b = -1;
    const draw = () => {
      const p = ((pos % N) + N) % N, i = Math.floor(p), j = (i + 1) % N, k = p - i;
      if (i !== a && cache[i].complete) { A.src = frames[i]; a = i; }
      if (j !== b && cache[j].complete) { B.src = frames[j]; b = j; }
      B.style.opacity = String(k);
    };
    if (!reduce) {
      addEventListener('scroll', () => { vel += (scrollY - lastY) * 0.01; lastY = scrollY; }, { passive: true });
      box.addEventListener('pointerdown', (e) => { drag = e.clientX; moved = 0; box.setPointerCapture(e.pointerId); });
      box.addEventListener('pointermove', (e) => { if (drag === null) return; const d = e.clientX - drag; moved += Math.abs(d); vel -= d * 0.012; drag = e.clientX; });
      box.addEventListener('pointerup', () => { if (moved < 6) location.href = '/work/'; drag = null; });
      const tick = () => { pos += 0.035 + vel; vel *= 0.92; draw(); requestAnimationFrame(tick); };
      requestAnimationFrame(tick);
    } else draw();
  }
  if (cnBox && cnCanvas && gl) {
    const cards = Array.from(cnBox.querySelectorAll<HTMLAnchorElement>('.cn__card a')).map((a) => ({ k: a.querySelector('.cn__k')!.textContent!, t: a.querySelector('strong')!.textContent!, href: a.getAttribute('href')! }));
    // While three.js loads, hold a still frame of the same 3D tower (not the
    // flat 2D drawing) so nothing pops; the live scene fades in over it.
    const seq = cnBox.querySelector<HTMLElement>('[data-cn-seq]')!;
    seq.hidden = false; seq.style.pointerEvents = 'none'; cnBox.classList.add('is-seq', 'is-hold');
    import('../scripts/webgl/cn-tower').then(async ({ cnTower }) => {
      await cnTower(cnCanvas, cards, reduce);
      cnBox.classList.add('is-3d');
      setTimeout(() => { seq.hidden = true; cnBox.classList.remove('is-seq', 'is-hold'); }, 900);
    }).catch((e) => { console.warn('About 3D tower failed', e); seq.hidden = true; cnBox.classList.remove('is-seq', 'is-hold'); });
  }
  // Fallback ring of cards around the tower pod: drifts slowly, spins with scroll and drag.
  const ring = document.querySelector<HTMLElement>('[data-ring]');
  if (ring) {
    let angle = 0, vel = 0, drag: number | null = null, lastY = scrollY;
    const set = () => ring.style.setProperty('--r', `${angle}deg`);
    if (!reduce) {
      addEventListener('scroll', () => { vel += (scrollY - lastY) * 0.12; lastY = scrollY; }, { passive: true });
      ring.addEventListener('pointerdown', (e) => { drag = e.clientX; ring.setPointerCapture(e.pointerId); });
      ring.addEventListener('pointermove', (e) => { if (drag === null) return; vel += (e.clientX - drag) * 0.25; drag = e.clientX; });
      ring.addEventListener('pointerup', () => { drag = null; });
      const tick = () => { angle -= 0.08 + vel; vel *= 0.9; set(); requestAnimationFrame(tick); };
      requestAnimationFrame(tick);
    } else { angle = -20; set(); }
  }
  // Live Toronto time.
  const clock = document.querySelector<HTMLElement>('[data-clock]');
  if (clock) {
    const f = new Intl.DateTimeFormat('en-CA', { hour: 'numeric', minute: '2-digit', timeZone: 'America/Toronto' });
    const up = () => { clock.textContent = f.format(new Date()).toUpperCase(); };
    up(); setInterval(up, 30000);
  }
  // Count up the numbers once.
  const nums = document.querySelectorAll<HTMLElement>('[data-count]');
  if (nums.length && !reduce) {
    const io = new IntersectionObserver((es) => es.forEach((e) => {
      if (!e.isIntersecting) return; io.unobserve(e.target);
      const el = e.target as HTMLElement, end = Number(el.dataset.count), t0 = performance.now();
      const tick = (t: number) => { const k = Math.min(1, (t - t0) / 1100); el.textContent = String(Math.round(end * (1 - Math.pow(1 - k, 3)))); if (k < 1) requestAnimationFrame(tick); };
      requestAnimationFrame(tick);
    }), { threshold: 0.6 });
    nums.forEach((n) => io.observe(n));
  }
</script>

<style>
  .ah { position: relative; overflow: hidden; color: #f4f1fb; background: linear-gradient(180deg, #0d0a1f 0%, #1c1440 55%, #4a2a6a 100%); }
  .ah__sky { position: absolute; inset: 0; pointer-events: none;
    background-image: radial-gradient(1.5px 1.5px at 12% 18%, #fff8 50%, transparent 51%), radial-gradient(1px 1px at 28% 62%, #fff6 50%, transparent 51%), radial-gradient(1.5px 1.5px at 44% 12%, #fff9 50%, transparent 51%), radial-gradient(1px 1px at 63% 34%, #fff7 50%, transparent 51%), radial-gradient(1.5px 1.5px at 82% 22%, #fff8 50%, transparent 51%), radial-gradient(1px 1px at 91% 58%, #fff6 50%, transparent 51%), radial-gradient(1px 1px at 55% 80%, #fff5 50%, transparent 51%), radial-gradient(1px 1px at 8% 82%, #fff5 50%, transparent 51%); }
  .ah__moon { position: absolute; top: 9%; right: 7%; width: 46px; height: 46px; border-radius: 50%; background: radial-gradient(circle at 35% 35%, #fffbe8, #e8dcc0 60%, #b9a98a); box-shadow: 0 0 40px 8px rgb(255 240 200 / .25); }
  .ah__inner { position: relative; display: grid; gap: var(--space-l); padding-block: var(--space-xl) var(--space-m); align-items: center; }
  @media (min-width: 64rem) { .ah__inner { grid-template-columns: minmax(0, 1fr) minmax(24rem, 34rem); min-height: calc(100svh - var(--header-h) - 5rem); } }
  .ah__text { display: grid; gap: var(--space-s); justify-items: start; }
  .ah__eyebrow { color: #cfc6ea; }
  .ah__title { font: 700 clamp(2.6rem, 1rem + 5.5vw, 6rem) / 0.98 var(--font-text); letter-spacing: -0.04em; max-width: 12ch; color: #fff; }
  .ah__title .accent { color: #ff7a45; }
  .ah__lede { max-width: 34rem; font-size: var(--step-1); line-height: 1.5; color: #cfc6ea; }
  .ah__ctas { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: var(--space-xs); }
  .ah__btn { min-height: 48px; display: inline-flex; align-items: center; padding: 0 1.4rem; border-radius: 999px; border: 1px solid rgb(255 255 255 / .35); color: #fff; text-decoration: none; font-weight: 500; transition: background .25s, color .25s; }
  .ah__btn:hover { background: rgb(255 255 255 / .12); }
  .ah__btn--solid { background: #fff; color: #0d0a1f; border-color: #fff; }
  .ah__btn--solid:hover { background: #ff7a45; border-color: #ff7a45; color: #fff; }
  .ah__btn:focus-visible { outline: 2px solid #ff7a45; outline-offset: 3px; }

  .cn { position: relative; height: clamp(28rem, 76vh, 46rem); }
  .cn__canvas { position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0; -webkit-mask-image: linear-gradient(180deg, #000 80%, transparent); mask-image: linear-gradient(180deg, #000 80%, transparent); transition: opacity .8s ease; touch-action: pan-y; }
  .cn:global(.is-3d) .cn__canvas { opacity: 1; }
  .cn:global(.is-3d) .cn__tower, .cn:global(.is-3d) .cn__stage { display: none; }
  .cn__hints { pointer-events: none; }
  .cn__seq { position: absolute; inset: 0; cursor: grab; touch-action: pan-y; user-select: none; }
  .cn__seq img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; object-position: 50% 0; -webkit-user-drag: none; pointer-events: none; }
  .cn__seq[hidden] { display: none; }
  .cn:global(.is-hold) .cn__seq img + img { display: none; }
  .cn:global(.is-3d) .cn__seq { opacity: 0; transition: opacity .8s ease; }
  .cn:global(.is-seq) .cn__tower, .cn:global(.is-seq) .cn__stage { display: none; }
  .cn__tower { position: absolute; left: 50%; bottom: calc(-1 * var(--space-m) - 3rem); height: calc(100% + var(--space-m) + 3rem); translate: -50% 0; }
  .cn__stage { position: absolute; left: 50%; top: 31%; width: 0; height: 0; perspective: 1100px; }
  .cn__ring { position: absolute; left: 0; top: 0; margin: 0; padding: 0; list-style: none; transform-style: preserve-3d; transform: rotateX(-8deg) rotateY(var(--r, 0deg)); }
  .cn__card { position: absolute; left: -4.6rem; top: -3.2rem; width: 9.2rem; height: 6.4rem; transform: rotateY(calc(var(--i) * 360deg / var(--n))) translateZ(12.5rem); backface-visibility: hidden; }
  .cn__card a { height: 100%; display: grid; align-content: space-between; padding: .8rem .9rem; border-radius: 14px; background: linear-gradient(160deg, #ffffff, #e9e2ff); color: #1a1238; text-decoration: none; box-shadow: 0 12px 30px -10px rgb(0 0 0 / .5); transition: background .25s, color .25s; }
  .cn__card:nth-child(odd) a { background: linear-gradient(160deg, #ff8a5c, #ee5a24); color: #fff; }
  .cn__card a:hover { background: #fff; color: #ee5a24; }
  .cn__k { font-size: .72rem; font-weight: 600; opacity: .7; }
  .cn__card strong { font: 700 1.05rem / 1.1 var(--font-text); letter-spacing: -0.02em; }
  .cn__pod { position: absolute; left: -5.6rem; top: 2.6rem; width: 11.2rem; height: 1.2rem; border-radius: 50%; background: #ff6a3d; box-shadow: 0 0 30px 6px rgb(255 106 61 / .45); transform: translateZ(0); }
  .cn__ring { cursor: grab; touch-action: pan-y; }
  .cn__ring:active { cursor: grabbing; }
  .cn__hints { position: absolute; left: 50%; bottom: 1.2rem; translate: -50% 0; display: flex; gap: .5rem; }
  .cn__hints span { padding: .35rem .8rem; border-radius: 999px; background: rgb(255 255 255 / .12); font-size: .75rem; color: #e9e2ff; backdrop-filter: blur(6px); white-space: nowrap; }
  .ah__meta { position: relative; display: flex; justify-content: space-between; padding-block: var(--space-s) var(--space-m); font: 500 .72rem / 1.5 var(--font-text); letter-spacing: .08em; color: #b8aed8; }
  .ah__clock { text-align: right; }
  @media (max-width: 63.99rem) { .cn { height: 26rem; } .cn__stage { top: 30%; } .cn__card { transform: rotateY(calc(var(--i) * 360deg / var(--n))) translateZ(9rem); width: 7.6rem; height: 5.4rem; left: -3.8rem; top: -2.7rem; } .cn__pod { width: 8rem; left: -4rem; top: 2.2rem; } }

  .stats { padding-block: var(--space-m); }
  .stats__row { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-m); margin: 0; padding: var(--space-m) 0; list-style: none; border-block: 1px solid var(--color-border); }
  @media (min-width: 48rem) { .stats__row { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .stats__row li { display: grid; gap: .2rem; }
  .stats__n { font: 700 clamp(2.4rem, 1.5rem + 3vw, 4.5rem) / 1 var(--font-text); letter-spacing: -0.04em; }
  .stats__l { color: var(--color-text-muted); }

  .does { padding-block: var(--space-xl); display: grid; gap: var(--space-s); }
  .does__h { max-width: 22ch; font: 600 clamp(1.6rem, 1.1rem + 1.6vw, 2.4rem) / 1.12 var(--font-text); letter-spacing: -0.03em; margin-bottom: var(--space-m); }
  .does__grid { display: grid; gap: var(--space-m); margin: 0; padding: 0; list-style: none; }
  @media (min-width: 40rem) { .does__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 64rem) { .does__grid { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .does__card a { display: grid; gap: .5rem; text-decoration: none; color: var(--color-text); }
  .does__media { aspect-ratio: 4 / 3; overflow: hidden; border-radius: var(--radius-m); background: var(--color-surface); }
  .does__media :global(img) { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .8s var(--ease-out); }
  .does__card:hover .does__media :global(img) { transform: scale(1.06); }
  .does__card h3 { margin-top: .4rem; font: 600 1.15rem / 1.2 var(--font-text); letter-spacing: -0.02em; }
  .does__card h3 span { display: inline-block; transition: transform .3s; }
  .does__card:hover h3 span { transform: translateX(4px); color: var(--color-accent); }
  .does__card p { color: var(--color-text-muted); }

  .tools { overflow: hidden; border-block: 1px solid var(--color-border); padding: 1rem 0; margin-block: var(--space-m) var(--space-xl); mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent); }
  .tools__track { display: flex; width: max-content; animation: tools 40s linear infinite; }
  .tools ul { display: flex; gap: 2.5rem; margin: 0; padding: 0 1.25rem; list-style: none; font: 600 clamp(1.4rem, 1rem + 1.5vw, 2.4rem) var(--font-text); letter-spacing: -0.03em; color: var(--color-text-muted); white-space: nowrap; }
  .tools li::after { content: '·'; margin-left: 2.5rem; color: var(--clay-bright); }
  .tools:hover .tools__track { animation-play-state: paused; }
  @keyframes tools { to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) { .tools__track { animation: none; } .tools ul[aria-hidden] { display: none; } .does__media :global(img), .ah__art { transition: none; } }
</style>

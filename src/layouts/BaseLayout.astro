---
/**
 * Base document for every page: <head> metadata, fonts, global CSS,
 * skip link, header and footer.
 *
 * Phase 6 extends the SEO block (per-page OG images, JSON-LD).
 * Phase 5 adds <ClientRouter /> for view transitions — so any page script
 * written from now on must be safe to re-run on `astro:page-load`.
 */
import { Font } from 'astro:assets';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import Cursor from '../components/ui/Cursor.astro';
import { site } from '../site.config';
import '../styles/reset.css';
import '../styles/tokens.css';
import '../styles/grid.css';
import '../styles/global.css';

interface Props {
  title?: string;
  /** 'glass' = floating liquid-glass navbar over a full-bleed hero (home). */
  headerVariant?: 'default' | 'glass';
  description?: string;
  ogImage?: string;
}

const { title, description = site.description, ogImage = '/og/default.png', headerVariant = 'default' } = Astro.props;
const fullTitle = title ? `${title} — ${site.name}` : `${site.name} — Product, Brand & Web Designer`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogUrl = new URL(ogImage, Astro.site);
---

<!doctype html>
<html lang="en-CA">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#e9ece4" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#131815" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <!-- Open Graph / social (expanded in Phase 6) -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Self-hosted fonts (configured in astro.config.mjs). Preload only the
         text font: it renders the first paint of body copy. -->
    <Font cssVariable="--font-display-src" />
    <Font cssVariable="--font-text-src" preload />
    <Font cssVariable="--font-mono-src" />
    <Font cssVariable="--font-hero-src" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header variant={headerVariant} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <Cursor />
    <!-- Motion entry: tiny; loads GSAP/Lenis only for mouse users who allow motion. -->
    <script>
      import '../scripts/motion/index.ts';
    </script>
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    left: var(--space-s);
    top: var(--space-s);
    z-index: 100;
    padding: var(--space-2xs) var(--space-s);
    background: var(--color-text);
    color: var(--color-bg);
    border-radius: var(--radius-s);
    transform: translateY(-200%);
  }
  .skip-link:focus { transform: none; }
  main:focus { outline: none; }
</style>
